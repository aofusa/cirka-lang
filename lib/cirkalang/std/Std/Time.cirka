-- Clocks (spec-v0.0.2.md §8.3).
module Std.Time

private extern "cirka" where
  cirka_clock_ns : Int -> IO Int

-- Nanoseconds since the Unix epoch (the wall clock).
now : IO Int
now = cirka_clock_ns 0

-- Nanoseconds of a monotonic clock (only differences are meaningful).
monotonic : IO Int
monotonic = cirka_clock_ns 1
