-- Command line arguments and environment variables (spec-v0.0.2.md §8.3).
module Std.Env

private extern "cirka" where
  cirka_getenv : String -> IO String
  cirka_env_has : String -> IO Int

-- The command line arguments (without the program name).
args : IO (List String)
args = do
  n <- argCount
  argsFrom (n - 1) Nil

private argsFrom : Int -> List String -> IO (List String)
argsFrom i acc =
  if i < 0 then pure acc
  else do
    a <- getArg i
    argsFrom (i - 1) (a :: acc)

-- The value of an environment variable, if it is set.
getEnv : String -> IO (Maybe String)
getEnv name = do
  h <- cirka_env_has name
  if h == 0 then pure Nothing else getSet name

private getSet : String -> IO (Maybe String)
getSet name = do
  v <- cirka_getenv name
  pure (Just v)
