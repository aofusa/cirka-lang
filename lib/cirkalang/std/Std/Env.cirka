-- Command line arguments, environment variables (spec-v0.0.2.md §8.3)
-- and the working directory (spec-v0.0.5.md §3.4).
module Std.Env

import Std.IO (IOError, MkIOError, checked)

private extern "cirka" where
  cirka_getenv : String -> IO String
  cirka_env_has : String -> IO Int
  cirka_errno : IO Int
  cirka_os_getcwd : IO String
  cirka_os_chdir : String -> IO Int

-- The command line arguments (without the program name).
args : IO (List String)
args = do
  n <- argCount
  argsFrom (n - 1) Nil

private argsFrom : Int -> List String -> IO (List String)
argsFrom i acc =
  if i < 0 then pure acc
  else do
    a <- getArg i
    argsFrom (i - 1) (a :: acc)

-- The value of an environment variable, if it is set.
getEnv : String -> IO (Maybe String)
getEnv name = do
  h <- cirka_env_has name
  if h == 0 then pure Nothing else getSet name

private getSet : String -> IO (Maybe String)
getSet name = do
  v <- cirka_getenv name
  pure (Just v)

-- The working directory of the process.
currentDirectory : IO (Result IOError String)
currentDirectory = do
  d <- cirka_os_getcwd
  e <- cirka_errno
  pure (if e /= 0 then Err (MkIOError e) else Ok d)

-- Changes the working directory of the process (of all its threads).
setCurrentDirectory : String -> IO (Result IOError ())
setCurrentDirectory path = do
  r <- cirka_os_chdir path
  pure (checked r)
