-- Files (spec-v0.0.2.md §8.3) and directories (spec-v0.0.5.md §3.4).
--
-- `readFile` / `writeFile` / `appendFile` work on whole files. A `File`
-- is an open file: a linear value that is closed when it is dropped
-- (`Release`), or explicitly by `close`, which reports the error.
--
-- The operations that name files take the capability `Cap FileSystem`
-- (spec-v0.0.7.md §1.3); those on an open `File` do not.
module Std.Fs

import Std.IO (IOError, MkIOError, checked)
import Data.Borrow
import Data.String as S

private extern "cirka" where
  cirka_errno : IO Int
  cirka_fs_open : String -> Int -> IO Int
  cirka_fd_read : Int -> Int -> IO String
  cirka_fd_write : Int -> String -> IO Int
  cirka_fd_close : Int -> IO Int
  cirka_fs_remove : String -> IO Int
  cirka_fs_list : String -> IO String
  cirka_fs_stat : String -> Int -> IO Int
  cirka_fs_mkdir : String -> Int -> IO Int
  cirka_fs_rmdir : String -> IO Int
  cirka_fs_rename : String -> String -> IO Int
  cirka_os_result : Int -> IO Int

-- An open file.
data File : LType where
  MkFile : Int -> File

impl Release File where
  release (MkFile fd) = do
    done <- cirka_fd_close fd
    pure ()

-- Opens a file for reading.
openRead : (0 fs : Cap FileSystem) -> String -> IO1 (Result IOError File)
openRead fs path = openMode path 0

-- Creates (or truncates) a file for writing.
create : (0 fs : Cap FileSystem) -> String -> IO1 (Result IOError File)
create fs path = openMode path 1

-- Opens a file for appending (creating it).
openAppend : (0 fs : Cap FileSystem) -> String -> IO1 (Result IOError File)
openAppend fs path = openMode path 2

private openMode : String -> Int -> IO1 (Result IOError File)
openMode path mode = do
  fd <- cirka_fs_open path mode
  pure1 (if fd < 0 then Err (MkIOError (0 - fd)) else Ok (MkFile fd))

-- Reads up to `n` bytes (an empty string at the end of the file).
read : (1 f : File) -> Int -> IO1 (File, Result IOError String)
read (MkFile fd) n = readFd (MkFile fd) fd n

-- Reads the rest of the file.
readAll : (1 f : File) -> IO1 (File, Result IOError String)
readAll (MkFile fd) = readFd (MkFile fd) fd (0 - 1)

private readFd : (1 f : File) -> Int -> Int -> IO1 (File, Result IOError String)
readFd f fd n = do
  s <- cirka_fd_read fd n
  e <- cirka_errno
  pure1 (f, if e /= 0 then Err (MkIOError e) else Ok s)

-- Writes all of `s`.
write : (1 f : File) -> String -> IO1 (File, Result IOError ())
write (MkFile fd) s = do
  r <- cirka_fd_write fd s
  pure1 (MkFile fd, checked r)

-- Closes the file.
close : (1 f : File) -> IO (Result IOError ())
close (MkFile fd) = do
  r <- cirka_fd_close fd
  pure (checked r)

-- The contents of the file at `path`.
readFile : (0 fs : Cap FileSystem) -> String -> IO (Result IOError String)
readFile fs path = do
  fd <- cirka_fs_open path 0
  if fd < 0 then pure (Err (MkIOError (0 - fd))) else readClose fd

private readClose : Int -> IO (Result IOError String)
readClose fd = do
  s <- cirka_fd_read fd (0 - 1)
  e <- cirka_errno
  done <- cirka_fd_close fd
  pure (if e /= 0 then Err (MkIOError e) else Ok s)

-- Writes `s` to the file at `path` (creating or truncating it).
writeFile : (0 fs : Cap FileSystem) -> String -> String -> IO (Result IOError ())
writeFile fs path s = writeMode path 1 s

-- Appends `s` to the file at `path` (creating it).
appendFile : (0 fs : Cap FileSystem) -> String -> String -> IO (Result IOError ())
appendFile fs path s = writeMode path 2 s

private writeMode : String -> Int -> String -> IO (Result IOError ())
writeMode path mode s = do
  fd <- cirka_fs_open path mode
  if fd < 0 then pure (Err (MkIOError (0 - fd))) else writeClose fd s

private writeClose : Int -> String -> IO (Result IOError ())
writeClose fd s = do
  r <- cirka_fd_write fd s
  c <- cirka_fd_close fd
  pure (if r < 0 then checked r else checked c)

-- Removes the file at `path`.
removeFile : (0 fs : Cap FileSystem) -> String -> IO (Result IOError ())
removeFile fs path = do
  r <- cirka_fs_remove path
  pure (checked r)

-- ---- directories and metadata (spec-v0.0.5.md §3.4) ----

-- The names in the directory (without `.` and `..`), sorted.
listDirectory : (0 fs : Cap FileSystem) -> String -> IO (Result IOError (List String))
listDirectory fs path = do
  names <- cirka_fs_list path
  e <- cirka_errno
  pure (if e /= 0 then Err (MkIOError e) else Ok (sortNames (namesOf names)))

-- The names of the runtime's list, each ended by a NUL.
private namesOf : String -> List String
namesOf s = map S.fromStr (filter (\n => not (S.isEmpty n)) (S.splitOn "\0" (S.toStr s)))

-- A merge sort.
private sortNames : List String -> List String
sortNames xs = mergeAll (map (\x => x :: Nil) xs)

private mergeAll : List (List String) -> List String
mergeAll Nil = Nil
mergeAll (x :: Nil) = x
mergeAll xs = mergeAll (mergePairs xs)

private mergePairs : List (List String) -> List (List String)
mergePairs (a :: b :: rest) = merge a b :: mergePairs rest
mergePairs xs = xs

private merge : List String -> List String -> List String
merge Nil ys = ys
merge xs Nil = xs
merge (x :: xs) (y :: ys) = if x <= y then x :: merge xs (y :: ys) else y :: merge (x :: xs) ys

-- What a path names.
data FileKind = RegularFile | Directory | SymbolicLink | OtherFile deriving (Eq, Show)

-- The metadata of a file: its kind, its size in bytes, its permission
-- bits (`493` = `0o755`, ...) and the time of its last change (seconds
-- since 1970).
data FileStatus = MkFileStatus FileKind Int Int Int

fileKind : FileStatus -> FileKind
fileKind (MkFileStatus k _ _ _) = k

fileSize : FileStatus -> Int
fileSize (MkFileStatus _ n _ _) = n

filePermissions : FileStatus -> Int
filePermissions (MkFileStatus _ _ p _) = p

modifiedTime : FileStatus -> Int
modifiedTime (MkFileStatus _ _ _ t) = t

-- The metadata of what `path` names (following symbolic links).
fileStatus : (0 fs : Cap FileSystem) -> String -> IO (Result IOError FileStatus)
fileStatus fs path = statusOf path 1

-- The metadata of `path` itself (a symbolic link is not followed).
linkStatus : (0 fs : Cap FileSystem) -> String -> IO (Result IOError FileStatus)
linkStatus fs path = statusOf path 0

private statusOf : String -> Int -> IO (Result IOError FileStatus)
statusOf path follow = do
  r <- cirka_fs_stat path follow
  if r < 0 then pure (Err (MkIOError (0 - r))) else statusFields

private statusFields : IO (Result IOError FileStatus)
statusFields = do
  size <- cirka_os_result 0
  kind <- cirka_os_result 1
  perms <- cirka_os_result 2
  time <- cirka_os_result 3
  pure (Ok (MkFileStatus (kindOf kind) size perms time))

private kindOf : Int -> FileKind
kindOf 1 = RegularFile
kindOf 2 = Directory
kindOf 3 = SymbolicLink
kindOf _ = OtherFile

-- Creates the directory (permissions `0o777` less the umask).
makeDirectory : (0 fs : Cap FileSystem) -> String -> IO (Result IOError ())
makeDirectory fs path = do
  r <- cirka_fs_mkdir path 511
  pure (checked r)

-- Removes the directory, which must be empty.
removeDirectory : (0 fs : Cap FileSystem) -> String -> IO (Result IOError ())
removeDirectory fs path = do
  r <- cirka_fs_rmdir path
  pure (checked r)

-- Renames (moves) `from` to `to`, replacing a file at `to`.
rename : (0 fs : Cap FileSystem) -> String -> String -> IO (Result IOError ())
rename fs from to = do
  r <- cirka_fs_rename from to
  pure (checked r)

-- ---- borrowed (spec-v0.0.3.md §2.3) ----

-- The operations on a file lent by `Data.Borrow.borrowIO`
-- (`borrowIO f as h in do { r <- writeB h "x"; readAllB h }`).

readB : Ref File r -> Int -> BorrowIO File r (Result IOError String)
readB h n = usingIO h (\(1 f : _) => urRead (read f n))

readAllB : Ref File r -> BorrowIO File r (Result IOError String)
readAllB h = usingIO h (\(1 f : _) => urRead (readAll f))

writeB : Ref File r -> String -> BorrowIO File r (Result IOError ())
writeB h s = usingIO h (\(1 f : _) => urWrite (write f s))

private urRead : (1 m : IO1 (File, Result IOError String)) -> IO1 (File, Ur (Result IOError String))
urRead m = do
  p <- m
  urPair p

private urPair : (1 p : (File, Result IOError String)) -> IO1 (File, Ur (Result IOError String))
urPair (f, x) = pure1 (f, MkUr x)

private urWrite : (1 m : IO1 (File, Result IOError ())) -> IO1 (File, Ur (Result IOError ()))
urWrite m = do
  p <- m
  urPairW p

private urPairW : (1 p : (File, Result IOError ())) -> IO1 (File, Ur (Result IOError ()))
urPairW (f, x) = pure1 (f, MkUr x)
