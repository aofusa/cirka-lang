-- Vulkan compute (spec-v0.0.6.md §3, FEAT-0251).
--
-- `withGpu` creates a Vulkan instance and a device with a compute queue,
-- runs a computation `VkIO s` with them, and then destroys everything it
-- created, the latest first, whether the computation succeeded or not.
-- The buffers and pipelines of the computation belong to the region `s`
-- of their device: a value whose type mentions `s` cannot leave
-- `withGpu` (E1200), so none outlives its device and none is left
-- undestroyed. Their constructors are private (spec-v0.0.6.md §2): they
-- are only made here, from handles that Vulkan gave.
--
-- Buffers live in memory that both the host and the device see
-- (host-visible and coherent), mapped while they exist: `write` and `read`
-- copy lists of elements in and out. `dispatch` runs a compute shader over
-- buffers and waits for it. Shaders are SPIR-V code: `spirvFile` reads it
-- from a file (that `glslc -o shader.spv shader.comp` wrote), `spirv`
-- takes it from C memory (such as an array that `glslc -mfmt=c` wrote,
-- linked from a C file), `spirvWords` from a list.
--
-- The raw bindings of vulkan_core.h are `Vulkan.Sys` (generated by
-- `cirka bindgen`).
module Vulkan

import Foreign
import Data.Borrow (Region)
import Data.Region
import Vulkan.Sys as C

private extern "C" where
  memset : Ptr () -> CInt -> CSize -> IO (Ptr ())
  fopen : Ptr CChar -> Ptr CChar -> IO (Ptr ())
  fread : Ptr () -> CSize -> CSize -> Ptr () -> IO CSize
  fseek : Ptr () -> CLong -> CInt -> IO CInt
  ftell : Ptr () -> IO CLong
  fclose : Ptr () -> IO CInt

-- ---- errors and computations ----

-- What failed: a Vulkan call with its `VkResult`, or a wrong use of this
-- module.
data VkError = Failed String Int | Invalid String deriving (Eq, Show)

-- A computation with the device of region `s`. It stops at the first
-- error.
data VkIO (s : Region) (a : Type) = private MkVkIO (RIO s (Result VkError a))

private runVk : VkIO s a -> RIO s (Result VkError a)
runVk (MkVkIO m) = m

private andThen : Result VkError a -> (a -> VkIO s b) -> RIO s (Result VkError b)
andThen (Err e) _ = pure (Err e)
andThen (Ok x) k = runVk (k x)

impl Functor (VkIO s) where
  fmap f m = MkVkIO (fmap (fmap f) (runVk m))

impl Monad (VkIO s) where
  pure x = MkVkIO (pure (Ok x))
  m >>= k = MkVkIO (runVk m >>= \r => andThen r k)

-- An `IO` action in a computation.
io : IO a -> VkIO s a
io m = MkVkIO (liftRIO (fmap Ok m))

-- Stops the computation with `e`.
throw : VkError -> VkIO s a
throw e = MkVkIO (pure (Err e))

private ioResult : IO (Result VkError a) -> VkIO s a
ioResult m = MkVkIO (liftRIO m)

-- ---- Vulkan calls ----

private code : C.VkResult -> Int
code (C.MkVkResult c) = fromCInt c

private checked : String -> C.VkResult -> Result VkError ()
checked what r = if r == C.VK_SUCCESS then Ok () else Err (Failed what (code r))

private callIO : String -> IO C.VkResult -> IO (Result VkError ())
callIO what act = fmap (checked what) act

private call : String -> IO C.VkResult -> VkIO s ()
call what act = ioResult (callIO what act)

-- The handle that `f` writes to its pointer.
private createIO : Storable h => String -> (Ptr h -> IO C.VkResult) -> IO (Result VkError h)
createIO what f = alloca (\p => createAt what f p)

private createAt : Storable h => String -> (Ptr h -> IO C.VkResult) -> Ptr h -> IO (Result VkError h)
createAt what f p = do
  r <- f p
  h <- peek p
  pure (fmap (\_ => h) (checked what r))

private created : Storable h => String -> (Ptr h -> IO C.VkResult) -> VkIO s h
created what f = ioResult (createIO what f)

-- The elements that a Vulkan enumeration writes: `f` is called with the
-- count and no array, then with an array of that many elements.
private enumerated : Storable a => String -> (Ptr CUInt -> Ptr a -> IO C.VkResult) -> VkIO s (List a)
enumerated what f = ioResult (alloca (\pn => enumerateIn what f pn))

private enumerateIn : Storable a => String -> (Ptr CUInt -> Ptr a -> IO C.VkResult) -> Ptr CUInt -> IO (Result VkError (List a))
enumerateIn what f pn = do
  poke pn (MkCUInt 0)
  r <- f pn nullPtr
  n <- peek pn
  if r /= C.VK_SUCCESS then pure (Err (Failed what (code r))) else allocaArray (count n + 1) (\arr => enumerateAll what f pn arr)

private enumerateAll : Storable a => String -> (Ptr CUInt -> Ptr a -> IO C.VkResult) -> Ptr CUInt -> Ptr a -> IO (Result VkError (List a))
enumerateAll what f pn arr = do
  r <- f pn arr
  n <- peek pn
  if r == C.VK_SUCCESS || r == C.VK_INCOMPLETE then fmap Ok (peekArray (count n) arr) else pure (Err (Failed what (code r)))

-- `m`, then `k` with its result, in `IO`.
private thenIO : IO (Result VkError a) -> (a -> IO (Result VkError b)) -> IO (Result VkError b)
thenIO m k = m >>= \r => thenWith r k

private thenWith : Result VkError a -> (a -> IO (Result VkError b)) -> IO (Result VkError b)
thenWith (Err e) _ = pure (Err e)
thenWith (Ok x) k = k x

-- `k` with the handle that `make` creates, which `free` then destroys.
private bracket : IO (Result VkError h) -> (h -> IO ()) -> (h -> IO (Result VkError a)) -> IO (Result VkError a)
bracket make free k = make >>= \r => bracketWith r free k

private bracketWith : Result VkError h -> (h -> IO ()) -> (h -> IO (Result VkError a)) -> IO (Result VkError a)
bracketWith (Err e) _ _ = pure (Err e)
bracketWith (Ok h) free k = do
  r <- k h
  done <- free h
  pure r

-- ---- integers, flags and lists ----

private count : CUInt -> Int
count (MkCUInt n) = n

private hasBits : CUInt -> Int -> Bool
hasBits (MkCUInt x) b = primAndInt x b == b

private queueBit : C.VkQueueFlagBits -> Int
queueBit (C.MkVkQueueFlagBits (MkCUInt b)) = b

private memoryBit : C.VkMemoryPropertyFlagBits -> Int
memoryBit (C.MkVkMemoryPropertyFlagBits (MkCUInt b)) = b

private usageBit : C.VkBufferUsageFlagBits -> Int
usageBit (C.MkVkBufferUsageFlagBits (MkCUInt b)) = b

private stageBit : C.VkShaderStageFlagBits -> Int
stageBit (C.MkVkShaderStageFlagBits (MkCUInt b)) = b

private accessBit : C.VkAccessFlagBits -> Int
accessBit (C.MkVkAccessFlagBits (MkCUInt b)) = b

private pipelineStageBit : C.VkPipelineStageFlagBits -> Int
pipelineStageBit (C.MkVkPipelineStageFlagBits (MkCUInt b)) = b

private commandUsageBit : C.VkCommandBufferUsageFlagBits -> Int
commandUsageBit (C.MkVkCommandBufferUsageFlagBits (MkCUInt b)) = b

private computeStages : CUInt
computeStages = MkCUInt (stageBit C.VK_SHADER_STAGE_COMPUTE_BIT)

private firstN : Int -> List a -> List a
firstN n Nil = Nil
firstN n (x :: xs) = if n <= 0 then Nil else x :: firstN (n - 1) xs

private mapIO : (a -> IO b) -> List a -> IO (List b)
mapIO f Nil = pure Nil
mapIO f (x :: xs) = do
  y <- f x
  ys <- mapIO f xs
  pure (y :: ys)

private withCStrings : List String -> (List (Ptr CChar) -> IO b) -> IO b
withCStrings Nil k = k Nil
withCStrings (x :: xs) k = withCString x (\p => withCStrings xs (\ps => k (p :: ps)))

-- ---- the GPU ----

-- How to set up the GPU: the name of the application, and whether to
-- enable the validation layer (`VK_LAYER_KHRONOS_validation`, which then
-- must be installed). The layer reports wrong uses of Vulkan on the
-- standard output.
data Options = MkOptions String Bool

-- An application named `name`, with the validation layer.
options : String -> Options
options name = MkOptions name True

-- A device with a compute queue, in the region `s` of `withGpu`. The
-- first field holds the actions that destroy what the computation
-- created, the latest first.
data Gpu (s : Region) = private MkGpu (RefIn s (List (IO ()))) C.VkDevice C.VkQueue C.VkCommandPool (List C.VkMemoryType) String String Bool

private exits : Gpu s -> RefIn s (List (IO ()))
exits (MkGpu ds _ _ _ _ _ _ _) = ds

private device : Gpu s -> C.VkDevice
device (MkGpu _ d _ _ _ _ _ _) = d

-- The name of the device (such as `llvmpipe (LLVM 20.1.2, 256 bits)`).
gpuName : Gpu s -> String
gpuName (MkGpu _ _ _ _ _ name _ _) = name

-- The kind of device: `discrete GPU`, `integrated GPU`, `virtual GPU`,
-- `CPU` or `other`.
gpuKind : Gpu s -> String
gpuKind (MkGpu _ _ _ _ _ _ kind _) = kind

-- Whether the validation layer checks the calls.
validated : Gpu s -> Bool
validated (MkGpu _ _ _ _ _ _ _ v) = v

private atExit : RefIn s (List (IO ())) -> IO () -> VkIO s ()
atExit ds act = MkVkIO (fmap Ok (modifyRefIn ds (\xs => act :: xs)))

-- Replaces the latest action of `ds` (when what it destroys is part of a
-- larger object).
private replaceExit : RefIn s (List (IO ())) -> IO () -> VkIO s ()
replaceExit ds act = MkVkIO (fmap Ok (modifyRefIn ds (\xs => act :: dropFirst xs)))

private dropFirst : List a -> List a
dropFirst Nil = Nil
dropFirst (x :: xs) = xs

-- Runs `f` with a device that can compute (the best kind first: discrete,
-- integrated, virtual GPU, then CPU), then destroys what it created.
withGpu : Options -> ((0 s : Region) -> Gpu s -> VkIO s a) -> IO (Result VkError a)
withGpu o f = withRegion (\s, arena => runGpu o arena (f s))

private runGpu : Options -> Arena s -> (Gpu s -> VkIO s a) -> RIO s (Result VkError a)
runGpu o arena k = do
  ds <- newRefIn arena Nil
  r <- runVk (open o ds >>= k)
  acts <- readRefIn ds
  done <- liftRIO (mapM_ (\act => act) acts)
  pure r

private validationLayer : String
validationLayer = "VK_LAYER_KHRONOS_validation"

private layerName : C.VkLayerProperties -> IO String
layerName l = withValue l (\p => peekCString (castPtr (C.VkLayerProperties.ptr_layerName p)))

private layersFor : Bool -> VkIO s (List String)
layersFor False = pure Nil
layersFor True = do
  ls <- enumerated "vkEnumerateInstanceLayerProperties" C.vkEnumerateInstanceLayerProperties
  names <- io (mapIO layerName ls)
  if elem validationLayer names then pure (validationLayer :: Nil) else throw (Invalid "the validation layer VK_LAYER_KHRONOS_validation is not installed")

private elem : String -> List String -> Bool
elem x Nil = False
elem x (y :: ys) = x == y || elem x ys

private createInstance : String -> List String -> VkIO s C.VkInstance
createInstance name layers = created "vkCreateInstance" (\p => withCString name (\pName => withCStrings layers (\ps => withArray ps (\pLayers => instanceWith pName (length layers) pLayers p))))

private instanceWith : Ptr CChar -> Int -> Ptr (Ptr CChar) -> Ptr C.VkInstance -> IO C.VkResult
instanceWith pName nLayers pLayers p =
  withValue (C.MkVkApplicationInfo C.VK_STRUCTURE_TYPE_APPLICATION_INFO nullPtr pName 1 pName 1 C.VK_API_VERSION_1_0) (\pApp =>
    withValue (C.MkVkInstanceCreateInfo C.VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO nullPtr 0 pApp (MkCUInt nLayers) pLayers 0 nullPtr) (\pInfo =>
      C.vkCreateInstance pInfo nullPtr p))

-- A physical device that can compute: the device, its rank (lower is
-- preferred), its queue family for compute, its name and kind.
private data Candidate = MkCandidate C.VkPhysicalDevice Int Int String String

private rankOf : Candidate -> Int
rankOf (MkCandidate _ r _ _ _) = r

private better : Candidate -> Candidate -> Candidate
better a b = if rankOf b < rankOf a then b else a

private typeCode : C.VkPhysicalDeviceType -> Int
typeCode (C.MkVkPhysicalDeviceType (MkCUInt t)) = t

private rank : Int -> Int
rank t = if t == 2 then 0 else if t == 1 then 1 else if t == 3 then 2 else if t == 4 then 3 else 4

private kindName : Int -> String
kindName t = if t == 2 then "discrete GPU" else if t == 1 then "integrated GPU" else if t == 3 then "virtual GPU" else if t == 4 then "CPU" else "other"

private computeFamily : List C.VkQueueFamilyProperties -> Int -> Maybe Int
computeFamily Nil _ = Nothing
computeFamily (q :: qs) i = if hasBits (C.VkQueueFamilyProperties.queueFlags q) (queueBit C.VK_QUEUE_COMPUTE_BIT) && count (C.VkQueueFamilyProperties.queueCount q) > 0 then Just i else computeFamily qs (i + 1)

private queueFamilies : C.VkPhysicalDevice -> Ptr CUInt -> Ptr C.VkQueueFamilyProperties -> IO C.VkResult
queueFamilies d pn arr = C.vkGetPhysicalDeviceQueueFamilyProperties d pn arr >> pure C.VK_SUCCESS

-- The rank, name and kind of a physical device.
private data Props = MkProps Int String String

private propsAt : C.VkPhysicalDevice -> Ptr C.VkPhysicalDeviceProperties -> IO Props
propsAt d p = do
  done <- C.vkGetPhysicalDeviceProperties d p
  t <- peek (C.VkPhysicalDeviceProperties.ptr_deviceType p)
  name <- peekCString (castPtr (C.VkPhysicalDeviceProperties.ptr_deviceName p))
  pure (MkProps (rank (typeCode t)) name (kindName (typeCode t)))

private candidate : C.VkPhysicalDevice -> VkIO s (Maybe Candidate)
candidate d = do
  qs <- enumerated "vkGetPhysicalDeviceQueueFamilyProperties" (queueFamilies d)
  MkProps r name kind <- io (alloca (\p => propsAt d p))
  pure (fmap (\fam => MkCandidate d r fam name kind) (computeFamily qs 0))

private candidates : List C.VkPhysicalDevice -> VkIO s (List Candidate)
candidates Nil = pure Nil
candidates (d :: ds) = do
  c <- candidate d
  cs <- candidates ds
  pure (consMaybe c cs)

private consMaybe : Maybe a -> List a -> List a
consMaybe Nothing xs = xs
consMaybe (Just x) xs = x :: xs

private best : List Candidate -> VkIO s Candidate
best Nil = throw (Invalid "no Vulkan device can compute")
best (c :: cs) = pure (foldl better c cs)

private queueInfo : Int -> Ptr CFloat -> C.VkDeviceQueueCreateInfo
queueInfo family pPriority = C.MkVkDeviceQueueCreateInfo C.VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO nullPtr 0 (MkCUInt family) 1 pPriority

private deviceInfo : Ptr C.VkDeviceQueueCreateInfo -> C.VkDeviceCreateInfo
deviceInfo pQueue = C.MkVkDeviceCreateInfo C.VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO nullPtr 0 1 pQueue 0 nullPtr 0 nullPtr nullPtr

private createDevice : C.VkPhysicalDevice -> Int -> VkIO s C.VkDevice
createDevice pd family = created "vkCreateDevice" (\p => withValue (MkCFloat 1.0) (\pPriority => withValue (queueInfo family pPriority) (\pQueue => withValue (deviceInfo pQueue) (\pInfo => C.vkCreateDevice pd pInfo nullPtr p))))

private queueAt : C.VkDevice -> Int -> Ptr C.VkQueue -> IO C.VkQueue
queueAt dev family p = C.vkGetDeviceQueue dev (MkCUInt family) 0 p >> peek p

private memoryAt : C.VkPhysicalDevice -> Ptr C.VkPhysicalDeviceMemoryProperties -> IO C.VkPhysicalDeviceMemoryProperties
memoryAt pd p = C.vkGetPhysicalDeviceMemoryProperties pd p >> peek p

private memoryTypes : C.VkPhysicalDeviceMemoryProperties -> List C.VkMemoryType
memoryTypes mp = case C.VkPhysicalDeviceMemoryProperties.memoryTypes mp of
  MkCArray ts => firstN (count (C.VkPhysicalDeviceMemoryProperties.memoryTypeCount mp)) ts

private poolInfo : Int -> C.VkCommandPoolCreateInfo
poolInfo family = C.MkVkCommandPoolCreateInfo C.VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO nullPtr 0 (MkCUInt family)

private open : Options -> RefIn s (List (IO ())) -> VkIO s (Gpu s)
open (MkOptions name validate) ds = do
  layers <- layersFor validate
  inst <- createInstance name layers
  atExit ds (C.vkDestroyInstance inst nullPtr)
  devs <- enumerated "vkEnumeratePhysicalDevices" (C.vkEnumeratePhysicalDevices inst)
  cs <- candidates devs
  MkCandidate pd _ family dname kind <- best cs
  dev <- createDevice pd family
  atExit ds (C.vkDestroyDevice dev nullPtr)
  queue <- io (alloca (\p => queueAt dev family p))
  pool <- created "vkCreateCommandPool" (\p => withValue (poolInfo family) (\pInfo => C.vkCreateCommandPool dev pInfo nullPtr p))
  atExit ds (C.vkDestroyCommandPool dev pool nullPtr)
  mp <- io (alloca (\p => memoryAt pd p))
  pure (MkGpu ds dev queue pool (memoryTypes mp) dname kind validate)

-- ---- buffers ----

-- A buffer of `n` elements of type `e` (a `Storable` type with the layout
-- of the shader's: `CFloat`, `CUInt`, `CInt`, ...).
data Buffer (s : Region) (e : Type) = private MkBuffer C.VkBuffer (Ptr e) Int

-- The number of elements of a buffer.
size : Buffer s e -> Int
size (MkBuffer _ _ n) = n

-- A buffer of `n` elements (`n >= 1`), all bytes zero.
buffer : Storable e => Gpu s -> Int -> VkIO s (Buffer s e)
buffer g n = newBuffer g n nullPtr

-- A buffer holding `xs` (at least one element).
fromList : Storable e => Gpu s -> List e -> VkIO s (Buffer s e)
fromList g xs = do
  b <- buffer g (length xs)
  write b xs
  pure b

-- Writes `xs` at the start of the buffer.
write : Storable e => Buffer s e -> List e -> VkIO s ()
write (MkBuffer _ p n) xs = if length xs > n then throw (Invalid "more elements than the buffer holds") else io (pokeArray p xs)

-- The elements of the buffer.
read : Storable e => Buffer s e -> VkIO s (List e)
read (MkBuffer _ p n) = io (peekArray n p)

private newBuffer : Storable e => Gpu s -> Int -> Ptr e -> VkIO s (Buffer s e)
newBuffer g n proxy = if n < 1 then throw (Invalid "a buffer holds at least one element") else allocBuffer g n (n * sizeOf proxy)

private storageUsage : CUInt
storageUsage = MkCUInt (usageBit C.VK_BUFFER_USAGE_STORAGE_BUFFER_BIT)

private bufferInfo : Int -> C.VkBufferCreateInfo
bufferInfo bytes = C.MkVkBufferCreateInfo C.VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO nullPtr 0 (MkCULong bytes) storageUsage C.VK_SHARING_MODE_EXCLUSIVE 0 nullPtr

private requirementsAt : C.VkDevice -> C.VkBuffer -> Ptr C.VkMemoryRequirements -> IO C.VkMemoryRequirements
requirementsAt dev b p = C.vkGetBufferMemoryRequirements dev b p >> peek p

-- Host-visible and coherent memory.
private hostMemory : Int
hostMemory = primOrInt (memoryBit C.VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) (memoryBit C.VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)

private findMemory : List C.VkMemoryType -> Int -> Int -> Maybe Int
findMemory Nil _ _ = Nothing
findMemory (t :: ts) allowed i = if primAndInt allowed (primShlInt 1 i) /= 0 && hasBits (C.VkMemoryType.propertyFlags t) hostMemory then Just i else findMemory ts allowed (i + 1)

private memoryFor : Gpu s -> C.VkMemoryRequirements -> VkIO s Int
memoryFor (MkGpu _ _ _ _ types _ _ _) req = case findMemory types (count (C.VkMemoryRequirements.memoryTypeBits req)) 0 of
  Nothing => throw (Invalid "the device has no host-visible, coherent memory for the buffer")
  Just i => pure i

private allocInfo : C.VkMemoryRequirements -> Int -> C.VkMemoryAllocateInfo
allocInfo req ty = C.MkVkMemoryAllocateInfo C.VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO nullPtr (C.VkMemoryRequirements.size req) (MkCUInt ty)

private destroyBuffer : C.VkDevice -> C.VkBuffer -> C.VkDeviceMemory -> IO ()
destroyBuffer dev b mem = C.vkDestroyBuffer dev b nullPtr >> C.vkFreeMemory dev mem nullPtr

private unmapDestroyBuffer : C.VkDevice -> C.VkBuffer -> C.VkDeviceMemory -> IO ()
unmapDestroyBuffer dev b mem = C.vkUnmapMemory dev mem >> destroyBuffer dev b mem

private allocBuffer : Storable e => Gpu s -> Int -> Int -> VkIO s (Buffer s e)
allocBuffer g n bytes = do
  let dev = device g
  b <- created "vkCreateBuffer" (\p => withValue (bufferInfo bytes) (\pInfo => C.vkCreateBuffer dev pInfo nullPtr p))
  atExit (exits g) (C.vkDestroyBuffer dev b nullPtr)
  req <- io (alloca (\p => requirementsAt dev b p))
  ty <- memoryFor g req
  mem <- created "vkAllocateMemory" (\p => withValue (allocInfo req ty) (\pInfo => C.vkAllocateMemory dev pInfo nullPtr p))
  replaceExit (exits g) (destroyBuffer dev b mem)
  call "vkBindBufferMemory" (C.vkBindBufferMemory dev b mem 0)
  ptr <- created "vkMapMemory" (\pp => C.vkMapMemory dev mem 0 C.VK_WHOLE_SIZE 0 pp)
  replaceExit (exits g) (unmapDestroyBuffer dev b mem)
  done <- io (memset ptr 0 (MkCSize bytes))
  pure (MkBuffer b (castPtr ptr) n)

-- ---- shaders and pipelines ----

-- SPIR-V code.
data Shader = private Code (Ptr CUInt) Int | Words (List CUInt)

-- The SPIR-V code of `bytes` bytes at `code`, which must stay valid while
-- pipelines are made from it (such as an array in C that `glslc -mfmt=c`
-- wrote). The pointer is trusted, as the extern declaration giving it.
spirv : Ptr CUInt -> Int -> Shader
spirv code bytes = Code code bytes

-- SPIR-V code given as its words.
spirvWords : List CUInt -> Shader
spirvWords ws = Words ws

-- The SPIR-V code in the file `path` (as `glslc -o path shader.comp`
-- writes it).
spirvFile : String -> VkIO s Shader
spirvFile path = ioResult (withCString path (\cpath => withCString "rb" (\mode => openSpirv path cpath mode)))

-- The magic number that SPIR-V code starts with (0x07230203).
private spirvMagic : CUInt
spirvMagic = MkCUInt 119734787

private notSpirv : String -> VkError
notSpirv path = Invalid (path ++ " is not SPIR-V code")

private openSpirv : String -> Ptr CChar -> Ptr CChar -> IO (Result VkError Shader)
openSpirv path cpath mode = do
  f <- fopen cpath mode
  if isNull f then pure (Err (Invalid ("cannot open " ++ path))) else readOpen path f

private readOpen : String -> Ptr () -> IO (Result VkError Shader)
readOpen path f = do
  n <- fileLength f
  r <- if n < 20 || n % 4 /= 0 || n > 268435456 then pure (Err (notSpirv path)) else bracketBytes n (\p => readWords path f n p)
  done <- fclose f
  pure r

-- The length of the open file `f` (-1 when it has none), which is then
-- read from its start.
private fileLength : Ptr () -> IO Int
fileLength f = do
  e <- fseek f (MkCLong 0) (MkCInt 2)
  n <- ftell f
  b <- fseek f (MkCLong 0) (MkCInt 0)
  pure (if fromCInt e /= 0 || fromCInt b /= 0 then 0 - 1 else fromCLong n)

-- `k` with `n` bytes of C memory, freed afterwards.
private bracketBytes : Int -> (Ptr CUInt -> IO b) -> IO b
bracketBytes n k = do
  p <- mallocBytes n
  r <- k p
  done <- freeBytes p
  pure r

private readWords : String -> Ptr () -> Int -> Ptr CUInt -> IO (Result VkError Shader)
readWords path f n p = do
  got <- fread (castPtr p) (MkCSize 1) (MkCSize n) f
  if fromCSize got /= n then pure (Err (Invalid ("cannot read " ++ path))) else wordsAt path n p

private wordsAt : String -> Int -> Ptr CUInt -> IO (Result VkError Shader)
wordsAt path n p = do
  ws <- peekArray (n / 4) p
  case ws of
    w :: _ => pure (if w == spirvMagic then Ok (Words ws) else Err (notSpirv path))
    Nil => pure (Err (notSpirv path))

-- A compute pipeline: its shader takes `buffers` storage buffers (set 0,
-- bindings 0, 1, ...) and `pushes` 32-bit push constants.
data Pipeline (s : Region) = private MkPipeline C.VkPipeline C.VkPipelineLayout C.VkDescriptorSetLayout Int Int

private moduleInfo : Int -> Ptr CUInt -> C.VkShaderModuleCreateInfo
moduleInfo bytes code = C.MkVkShaderModuleCreateInfo C.VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO nullPtr 0 (MkCSize bytes) code

private moduleIO : C.VkDevice -> Shader -> IO (Result VkError C.VkShaderModule)
moduleIO dev (Code code bytes) = createIO "vkCreateShaderModule" (\p => withValue (moduleInfo bytes code) (\pInfo => C.vkCreateShaderModule dev pInfo nullPtr p))
moduleIO dev (Words ws) = withArray ws (\code => moduleIO dev (Code code (4 * length ws)))

private bindingAt : Int -> C.VkDescriptorSetLayoutBinding
bindingAt i = C.MkVkDescriptorSetLayoutBinding (MkCUInt i) C.VK_DESCRIPTOR_TYPE_STORAGE_BUFFER 1 computeStages nullPtr

private setLayoutInfo : Int -> Ptr C.VkDescriptorSetLayoutBinding -> C.VkDescriptorSetLayoutCreateInfo
setLayoutInfo n pBindings = C.MkVkDescriptorSetLayoutCreateInfo C.VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO nullPtr 0 (MkCUInt n) pBindings

private layoutInfo : Ptr C.VkDescriptorSetLayout -> Int -> Ptr C.VkPushConstantRange -> C.VkPipelineLayoutCreateInfo
layoutInfo pSet pushes pRange = C.MkVkPipelineLayoutCreateInfo C.VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO nullPtr 0 1 pSet (if pushes > 0 then 1 else 0) pRange

private pushRange : Int -> C.VkPushConstantRange
pushRange pushes = C.MkVkPushConstantRange computeStages 0 (MkCUInt (4 * pushes))

private stageInfo : C.VkShaderModule -> Ptr CChar -> C.VkPipelineShaderStageCreateInfo
stageInfo m pMain = C.MkVkPipelineShaderStageCreateInfo C.VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO nullPtr 0 C.VK_SHADER_STAGE_COMPUTE_BIT m pMain nullPtr

private pipelineInfo : C.VkShaderModule -> Ptr CChar -> C.VkPipelineLayout -> C.VkComputePipelineCreateInfo
pipelineInfo m pMain layout = C.MkVkComputePipelineCreateInfo C.VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO nullPtr 0 (stageInfo m pMain) layout nullPtr (MkCInt (0 - 1))

-- A pipeline running `shader` (entry point `main`), whose shader takes
-- `buffers` storage buffers and `pushes` 32-bit push constants.
pipeline : Gpu s -> Shader -> Int -> Int -> VkIO s (Pipeline s)
pipeline g shader buffers pushes = do
  let dev = device g
  m <- ioResult (moduleIO dev shader)
  atExit (exits g) (C.vkDestroyShaderModule dev m nullPtr)
  set <- created "vkCreateDescriptorSetLayout" (\p => withArray (map bindingAt (range 0 (buffers - 1))) (\pBindings => withValue (setLayoutInfo buffers pBindings) (\pInfo => C.vkCreateDescriptorSetLayout dev pInfo nullPtr p)))
  atExit (exits g) (C.vkDestroyDescriptorSetLayout dev set nullPtr)
  layout <- created "vkCreatePipelineLayout" (\p => withValue set (\pSet => withValue (pushRange pushes) (\pRange => withValue (layoutInfo pSet pushes pRange) (\pInfo => C.vkCreatePipelineLayout dev pInfo nullPtr p))))
  atExit (exits g) (C.vkDestroyPipelineLayout dev layout nullPtr)
  pl <- created "vkCreateComputePipelines" (\p => withCString "main" (\pMain => withValue (pipelineInfo m pMain layout) (\pInfo => C.vkCreateComputePipelines dev nullPtr 1 pInfo nullPtr p)))
  atExit (exits g) (C.vkDestroyPipeline dev pl nullPtr)
  pure (MkPipeline pl layout set buffers pushes)

-- ---- dispatch ----

-- A buffer bound to a binding of a pipeline.
data Arg (s : Region) = private MkArg C.VkBuffer Int

-- Binds a buffer (the whole of it).
arg : Storable e => Buffer s e -> Arg s
arg (MkBuffer b p n) = MkArg b (n * sizeOf p)

-- A 32-bit push constant: an `int` / `uint` or a `float` of the shader.
data Push = PushInt Int | PushFloat Float

-- Runs the pipeline over `x * y * z` workgroups, with the buffers `args`
-- (bindings 0, 1, ...) and the push constants `pushes`, and waits until it
-- is done: then `read` sees what the shader wrote. Each count is at least
-- 1 and at most 65535, the least `maxComputeWorkGroupCount` that every
-- Vulkan device supports.
dispatch : Gpu s -> Pipeline s -> List (Arg s) -> List Push -> {x : Int | 1 <= x && x <= 65535} -> {y : Int | 1 <= y && y <= 65535} -> {z : Int | 1 <= z && z <= 65535} -> VkIO s ()
dispatch g (MkPipeline pl layout set nbuf npush) args pushes x y z =
  if length args /= nbuf then throw (Invalid "dispatch: the number of buffers differs from the pipeline's")
  else if length pushes /= npush then throw (Invalid "dispatch: the number of push constants differs from the pipeline's")
  else ioResult (runDispatch g pl layout set nbuf args pushes x y z)

private poolSizeOf : Int -> C.VkDescriptorPoolSize
poolSizeOf n = C.MkVkDescriptorPoolSize C.VK_DESCRIPTOR_TYPE_STORAGE_BUFFER (MkCUInt n)

private descriptorPoolInfo : Ptr C.VkDescriptorPoolSize -> C.VkDescriptorPoolCreateInfo
descriptorPoolInfo pSizes = C.MkVkDescriptorPoolCreateInfo C.VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO nullPtr 0 1 1 pSizes

private setAllocInfo : C.VkDescriptorPool -> Ptr C.VkDescriptorSetLayout -> C.VkDescriptorSetAllocateInfo
setAllocInfo pool pSet = C.MkVkDescriptorSetAllocateInfo C.VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO nullPtr pool 1 pSet

private bufferInfoOf : Arg s -> C.VkDescriptorBufferInfo
bufferInfoOf (MkArg b bytes) = C.MkVkDescriptorBufferInfo b 0 (MkCULong bytes)

private writeAt : C.VkDescriptorSet -> Ptr C.VkDescriptorBufferInfo -> Int -> C.VkWriteDescriptorSet
writeAt set pInfos i = C.MkVkWriteDescriptorSet C.VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET nullPtr set (MkCUInt i) 0 1 C.VK_DESCRIPTOR_TYPE_STORAGE_BUFFER nullPtr (advancePtr pInfos i) nullPtr

private commandInfo : C.VkCommandPool -> C.VkCommandBufferAllocateInfo
commandInfo pool = C.MkVkCommandBufferAllocateInfo C.VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO nullPtr pool C.VK_COMMAND_BUFFER_LEVEL_PRIMARY 1

private beginInfo : C.VkCommandBufferBeginInfo
beginInfo = C.MkVkCommandBufferBeginInfo C.VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO nullPtr (MkCUInt (commandUsageBit C.VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT)) nullPtr

-- What the shader wrote becomes visible to the host.
private toHost : C.VkMemoryBarrier
toHost = C.MkVkMemoryBarrier C.VK_STRUCTURE_TYPE_MEMORY_BARRIER nullPtr (MkCUInt (accessBit C.VK_ACCESS_SHADER_WRITE_BIT)) (MkCUInt (accessBit C.VK_ACCESS_HOST_READ_BIT))

private fenceInfo : C.VkFenceCreateInfo
fenceInfo = C.MkVkFenceCreateInfo C.VK_STRUCTURE_TYPE_FENCE_CREATE_INFO nullPtr 0

private submitInfo : Ptr C.VkCommandBuffer -> C.VkSubmitInfo
submitInfo pCmd = C.MkVkSubmitInfo C.VK_STRUCTURE_TYPE_SUBMIT_INFO nullPtr 0 nullPtr nullPtr 1 pCmd 0 nullPtr

private pokePushes : Ptr CUInt -> Int -> List Push -> IO ()
pokePushes p i Nil = pure ()
pokePushes p i (PushInt n :: rest) = poke (plusPtr p (4 * i) : Ptr CInt) (MkCInt n) >> pokePushes p (i + 1) rest
pokePushes p i (PushFloat f :: rest) = poke (plusPtr p (4 * i) : Ptr CFloat) (MkCFloat f) >> pokePushes p (i + 1) rest

private runDispatch : Gpu s -> C.VkPipeline -> C.VkPipelineLayout -> C.VkDescriptorSetLayout -> Int -> List (Arg s) -> List Push -> Int -> Int -> Int -> IO (Result VkError ())
runDispatch (MkGpu _ dev queue cmdPool _ _ _ _) pl layout setLayout nbuf args pushes x y z =
  bracket (createIO "vkCreateDescriptorPool" (\p => withValue (poolSizeOf nbuf) (\pSizes => withValue (descriptorPoolInfo pSizes) (\pInfo => C.vkCreateDescriptorPool dev pInfo nullPtr p))))
    (\pool => C.vkDestroyDescriptorPool dev pool nullPtr)
    (\pool => thenIO (createIO "vkAllocateDescriptorSets" (\p => withValue setLayout (\pSet => withValue (setAllocInfo pool pSet) (\pInfo => C.vkAllocateDescriptorSets dev pInfo p))))
      (\set => updateAndRun dev queue cmdPool pl layout set args pushes x y z))

private updateAndRun : C.VkDevice -> C.VkQueue -> C.VkCommandPool -> C.VkPipeline -> C.VkPipelineLayout -> C.VkDescriptorSet -> List (Arg s) -> List Push -> Int -> Int -> Int -> IO (Result VkError ())
updateAndRun dev queue cmdPool pl layout set args pushes x y z = do
  done <- withArray (map bufferInfoOf args) (\pInfos => withArray (map (writeAt set pInfos) (range 0 (length args - 1))) (\pWrites => C.vkUpdateDescriptorSets dev (MkCUInt (length args)) pWrites 0 nullPtr))
  bracket (createIO "vkAllocateCommandBuffers" (\p => withValue (commandInfo cmdPool) (\pInfo => C.vkAllocateCommandBuffers dev pInfo p)))
    (\cmd => withValue cmd (\pCmd => C.vkFreeCommandBuffers dev cmdPool 1 pCmd))
    (\cmd => thenIO (record cmd pl layout set pushes x y z) (\_ => submitWait dev queue cmd))

private record : C.VkCommandBuffer -> C.VkPipeline -> C.VkPipelineLayout -> C.VkDescriptorSet -> List Push -> Int -> Int -> Int -> IO (Result VkError ())
record cmd pl layout set pushes x y z = thenIO (withValue beginInfo (\pInfo => callIO "vkBeginCommandBuffer" (C.vkBeginCommandBuffer cmd pInfo))) (\_ => do
  done <- C.vkCmdBindPipeline cmd C.VK_PIPELINE_BIND_POINT_COMPUTE pl
  done <- withValue set (\pSet => C.vkCmdBindDescriptorSets cmd C.VK_PIPELINE_BIND_POINT_COMPUTE layout 0 1 pSet 0 nullPtr)
  done <- pushConstants cmd layout pushes
  done <- C.vkCmdDispatch cmd (MkCUInt x) (MkCUInt y) (MkCUInt z)
  done <- withValue toHost (\pBarrier => C.vkCmdPipelineBarrier cmd (MkCUInt (pipelineStageBit C.VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT)) (MkCUInt (pipelineStageBit C.VK_PIPELINE_STAGE_HOST_BIT)) 0 1 pBarrier 0 nullPtr 0 nullPtr)
  callIO "vkEndCommandBuffer" (C.vkEndCommandBuffer cmd))

private pushConstants : C.VkCommandBuffer -> C.VkPipelineLayout -> List Push -> IO ()
pushConstants cmd layout Nil = pure ()
pushConstants cmd layout pushes = allocaArray (length pushes) (\p => pokePushes p 0 pushes >> C.vkCmdPushConstants cmd layout computeStages 0 (MkCUInt (4 * length pushes)) (castPtr p))

private submitWait : C.VkDevice -> C.VkQueue -> C.VkCommandBuffer -> IO (Result VkError ())
submitWait dev queue cmd =
  bracket (createIO "vkCreateFence" (\p => withValue fenceInfo (\pInfo => C.vkCreateFence dev pInfo nullPtr p)))
    (\fence => C.vkDestroyFence dev fence nullPtr)
    (\fence => thenIO (withValue cmd (\pCmd => withValue (submitInfo pCmd) (\pInfo => callIO "vkQueueSubmit" (C.vkQueueSubmit queue 1 pInfo fence))))
      (\_ => withValue fence (\pFence => callIO "vkWaitForFences" (C.vkWaitForFences dev 1 pFence C.VK_TRUE (MkCULong (0 - 1))))))
