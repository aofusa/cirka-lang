-- The CirkaLang Prelude (spec-v0.0.1.md §3.1, §5; traits: spec-v0.0.2.md
-- §3). Imported implicitly by every module.
module Prelude

infixr 9 .
infixl 7 *, /, %, *., /.
infixl 6 +, -, +., -., ++
infixr 5 ::
infix 4 ==, /=, <, <=, >, >=, ==., <., <=., >., >=.
infixr 3 &&
infixr 2 ||
infixl 1 >>=, >>
infixr 0 $

-- Primitive types (§5.4)
prim Int : Type
prim UInt : Type
prim Float : Type
prim Char : Type
prim String : Type
prim IO : Type -> Type
prim Unique : Type -> LType
-- An action whose result is linear (spec-v0.0.2.md §5.2).
prim IO1 : LType -> Type

-- Basic data types
data Bool = False | True deriving (Eq, Ord, Show)
data Unit = MkUnit deriving (Eq, Ord)
data Ordering = LT | EQ | GT deriving (Eq, Ord, Show)
data Nat = Z | S Nat deriving (Eq, Ord, Show)
data Pair a b = MkPair a b deriving (Eq, Ord)
data List a = Nil | a :: List a deriving (Eq, Ord)
data Maybe a = Nothing | Just a deriving (Eq, Ord, Show)
data Either a b = Left a | Right b deriving (Eq, Ord, Show)
-- The result of an operation that can fail (spec-v0.0.2.md §6).
data Result e a = Err e | Ok a deriving (Eq, Ord, Show)

-- An unrestricted value (spec-v0.0.2.md §5.6): its field is declared `ω`,
-- so it may be used many times even when it comes out of a linear value
-- (`case read u i of (u, MkUr x) => ...`).
data Ur (a : Type) : Type where
  MkUr : (ω x : a) -> Ur a

-- Propositional equality (spec-v0.0.4.md §2.1): `x = y` is `Equal x y`.
-- Proofs are ordinary values; used with multiplicity 0 they are erased.
data Equal : {a : Type} -> (0 x : a) -> (0 y : a) -> Type where
  Refl : {0 x : a} -> Equal x x

-- The empty type: there is no proof of `Void`.
data Void : Type where

-- A decided proposition: a proof of `p` or a refutation.
data Dec (p : Type) = Yes p | No (p -> Void)

-- A proof that a boolean is `True`.
data So : Bool -> Type where
  Oh : So True

-- `rewrite` (spec-v0.0.4.md §2.2): the identity at run time.
prim primRewrite : {a : Type} -> (0 p : a -> LType) -> (0 x : a) -> (0 y : a) -> (0 eq : x = y) -> (1 v : p y) -> p x

-- Refinement types (spec-v0.0.4.md §3): `{x : a | p}` is `subsetOf a (\x => p)`,
-- a value of `a` (the same at run time) of which `p` holds. `primRefine`
-- marks where a value is checked against one (the identity at run time).
-- `subsetOf a p` reduces to `a`.
prim subsetOf : (a : Type) -> (a -> Bool) -> Type

prim primRefine : {a : Type} -> (0 p : a -> Bool) -> (0 site : Int) -> a -> a

-- Operations whose check a proof makes unnecessary (spec-v0.0.4.md §5),
-- used only by `divNZ`, `modNZ` and `unreachable` below.
private prim primDivProved : Int -> Int -> Int
private prim primModProved : Int -> Int -> Int
private prim primUnreachable : {a : LType} -> () -> a

-- Primitive operations (§5.6)
prim primAddInt : Int -> Int -> Int
prim primSubInt : Int -> Int -> Int
prim primMulInt : Int -> Int -> Int
prim primDivInt : Int -> Int -> Int
prim primModInt : Int -> Int -> Int
prim primNegInt : Int -> Int
prim primEqInt : Int -> Int -> Bool
prim primLtInt : Int -> Int -> Bool
prim primLeInt : Int -> Int -> Bool
prim primAndInt : Int -> Int -> Int
prim primOrInt : Int -> Int -> Int
prim primXorInt : Int -> Int -> Int
prim primShlInt : Int -> Int -> Int
prim primShrInt : Int -> Int -> Int
prim primAddUInt : UInt -> UInt -> UInt
prim primSubUInt : UInt -> UInt -> UInt
prim primMulUInt : UInt -> UInt -> UInt
prim primEqUInt : UInt -> UInt -> Bool
prim primLtUInt : UInt -> UInt -> Bool
prim primLeUInt : UInt -> UInt -> Bool
prim primIntToUInt : Int -> UInt
prim primUIntToInt : UInt -> Int
prim primAddFloat : Float -> Float -> Float
prim primSubFloat : Float -> Float -> Float
prim primMulFloat : Float -> Float -> Float
prim primDivFloat : Float -> Float -> Float
prim primNegFloat : Float -> Float
prim primEqFloat : Float -> Float -> Bool
prim primLtFloat : Float -> Float -> Bool
prim primLeFloat : Float -> Float -> Bool
prim primIntToFloat : Int -> Float
prim primFloatToInt : Float -> Int
prim primSqrtFloat : Float -> Float
prim primTruncFloat : Float -> Float
prim primCharToInt : Char -> Int
prim primIntToChar : Int -> Char
prim primStrLength : String -> Int
prim primStrIndex : String -> Int -> Int
prim primStrConcat : String -> String -> String
prim primStrEq : String -> String -> Bool
prim primIntToStr : Int -> String
prim primFloatToStr : Float -> String
prim primCharToStr : Char -> String

-- IO (§5.2)
prim primPure : a -> IO a
-- The action and the continuation run once, so they may capture linear
-- values.
prim primBind : (1 m : IO a) -> (1 k : a -> IO b) -> IO b
-- `IO1 a` binds its result with multiplicity 1 (spec-v0.0.2.md §5.2).
prim primPure1 : {a : LType} -> (1 x : a) -> IO1 a
prim primBind1 : {a : LType} -> {b : Type} -> (1 m : IO1 a) -> (1 k : (1 x : a) -> IO b) -> IO b
prim primBindTo1 : {a : Type} -> {b : LType} -> (1 m : IO a) -> (1 k : a -> IO1 b) -> IO1 b
prim primBind11 : {a : LType} -> {b : LType} -> (1 m : IO1 a) -> (1 k : (1 x : a) -> IO1 b) -> IO1 b
prim putStr : String -> IO ()
prim printInt : Int -> IO ()
prim printFloat : Float -> IO ()
prim putChar : Char -> IO ()
prim readInt : IO Int
-- Command line arguments (without the program name); `getArg` panics when
-- the index is out of range.
prim argCount : IO Int
prim getArg : Int -> IO String
prim exit : Int -> IO a
-- The result may be linear: `panic` does not return (spec-v0.0.2.md §6).
prim panic : {a : LType} -> String -> a

-- Uniqueness (§4.3)
prim unique : a -> Unique a
prim freeze : (1 u : Unique a) -> a

-- Traits
trait Eq a where
  (==), (/=) : a -> a -> Bool
  x == y = not (x /= y)
  x /= y = not (x == y)

trait Eq a => Ord a where
  compare : a -> a -> Ordering
  (<), (<=), (>), (>=) : a -> a -> Bool
  compare x y = if x == y then EQ else if x <= y then LT else GT
  x < y = case compare x y of
    LT => True
    _ => False
  x <= y = case compare x y of
    GT => False
    _ => True
  x > y = case compare x y of
    GT => True
    _ => False
  x >= y = case compare x y of
    LT => False
    _ => True

trait Show a where
  show : a -> String
  -- `showPrec d x`: `x` in a context of precedence `d` (the argument
  -- of a function application is at 11).
  showPrec : Int -> a -> String
  show x = showPrec 0 x
  showPrec _ x = show x

trait Num a where
  (+), (-), (*) : a -> a -> a
  negate : a -> a
  fromInt : Int -> a
  x - y = x + negate y
  negate x = fromInt 0 - x

-- Division (`%` is the remainder of truncating division).
trait Div a where
  (/), (%) : a -> a -> a

trait Functor (f : Type -> Type) where
  fmap : (a -> b) -> f a -> f b

trait Functor m => Monad (m : Type -> Type) where
  pure : a -> m a
  (>>=) : m a -> (a -> m b) -> m b

(>>) : Monad m => m a -> m b -> m b
m >> k = m >>= \_ => k

impl Functor IO where
  fmap f m = primBind m (\x => primPure (f x))

impl Monad IO where
  pure x = primPure x
  m >>= f = primBind m f

impl Functor Maybe where
  fmap f Nothing = Nothing
  fmap f (Just x) = Just (f x)

impl Monad Maybe where
  pure x = Just x
  Nothing >>= _ = Nothing
  (Just x) >>= f = f x

impl Functor List where
  fmap f xs = map f xs

impl Monad List where
  pure x = x :: Nil
  xs >>= f = concatMap f xs

impl Functor (Either e) where
  fmap f (Left e) = Left e
  fmap f (Right x) = Right (f x)

impl Monad (Either e) where
  pure x = Right x
  (Left e) >>= _ = Left e
  (Right x) >>= f = f x

impl Functor (Result e) where
  fmap f (Err e) = Err e
  fmap f (Ok x) = Ok (f x)

impl Monad (Result e) where
  pure x = Ok x
  (Err e) >>= _ = Err e
  (Ok x) >>= f = f x

-- Resources (spec-v0.0.2.md §5.3). A linear value that is not used is
-- given up by the compiler: with `drop` as early as possible, or in an
-- action with `drop` / `release` at the end of the action, latest bound
-- first. Values that hold only memory need neither (Perceus frees them).
trait Drop (a : LType) where
  drop : (1 x : a) -> ()

trait Release (a : LType) where
  release : (1 x : a) -> IO ()

-- The finalizers of values that hold only memory (they do nothing).
prim dropFree : {a : LType} -> (1 x : a) -> ()
prim releaseFree : {a : LType} -> (1 x : a) -> IO ()

-- A value that can be dropped can be released.
releaseByDrop : {a : LType} -> Drop a => (1 x : a) -> IO ()
releaseByDrop x = case drop x of
  MkUnit => primPure MkUnit

-- `act`, then the finalizer of `x` (inserted at the end of actions).
dropAfter : {a : LType} -> {r : Type} -> Drop a => (1 x : a) -> (1 act : IO r) -> IO r
dropAfter x act = primBind act (dropThen x)

private dropThen : {a : LType} -> {r : Type} -> Drop a => (1 x : a) -> r -> IO r
dropThen x r = case drop x of
  MkUnit => primPure r

releaseAfter : {a : LType} -> {r : Type} -> Release a => (1 x : a) -> (1 act : IO r) -> IO r
releaseAfter x act = primBind act (releaseThen x)

private releaseThen : {a : LType} -> {r : Type} -> Release a => (1 x : a) -> r -> IO r
releaseThen x r = primBind (release x) (\_ => primPure r)

dropAfter1 : {a : LType} -> {r : LType} -> Drop a => (1 x : a) -> (1 act : IO1 r) -> IO1 r
dropAfter1 x act = primBind11 act (dropThen1 x)

private dropThen1 : {a : LType} -> {r : LType} -> Drop a => (1 x : a) -> (1 v : r) -> IO1 r
dropThen1 x v = case drop x of
  MkUnit => primPure1 v

releaseAfter1 : {a : LType} -> {r : LType} -> Release a => (1 x : a) -> (1 act : IO1 r) -> IO1 r
releaseAfter1 x act = primBind11 act (releaseThen1 x)

private releaseThen1 : {a : LType} -> {r : LType} -> Release a => (1 x : a) -> (1 v : r) -> IO1 r
releaseThen1 x v = primBindTo1 (release x) (\_ => primPure1 v)

-- The finalizers of containers finalize their elements.
impl Drop a => Drop (List a) where
  drop Nil = MkUnit
  drop (x :: xs) = case drop x of
    MkUnit => drop xs

impl Release a => Release (List a) where
  release Nil = primPure MkUnit
  release (x :: xs) = primBind (release x) (\_ => release xs)

impl Drop a => Drop (Maybe a) where
  drop Nothing = MkUnit
  drop (Just x) = drop x

impl Release a => Release (Maybe a) where
  release Nothing = primPure MkUnit
  release (Just x) = release x

impl (Drop a, Drop b) => Drop (Pair a b) where
  drop (MkPair x y) = case drop x of
    MkUnit => drop y

impl (Release a, Release b) => Release (Pair a b) where
  release (MkPair x y) = primBind (release x) (\_ => release y)

impl (Drop a, Drop b) => Drop (Either a b) where
  drop (Left x) = drop x
  drop (Right y) = drop y

impl (Release a, Release b) => Release (Either a b) where
  release (Left x) = release x
  release (Right y) = release y

impl (Drop e, Drop a) => Drop (Result e a) where
  drop (Err x) = drop x
  drop (Ok y) = drop y

impl (Release e, Release a) => Release (Result e a) where
  release (Err x) = release x
  release (Ok y) = release y

impl Eq Int where
  x == y = primEqInt x y
  x /= y = not (primEqInt x y)

impl Ord Int where
  compare x y = if primLtInt x y then LT else if primEqInt x y then EQ else GT
  x < y = primLtInt x y
  x <= y = primLeInt x y
  x > y = primLtInt y x
  x >= y = primLeInt y x

impl Num Int where
  x + y = primAddInt x y
  x - y = primSubInt x y
  x * y = primMulInt x y
  negate x = primNegInt x
  fromInt n = n

impl Div Int where
  x / y = primDivInt x y
  x % y = primModInt x y

impl Show Int where
  show n = primIntToStr n
  showPrec d n = showParen (d > 6 && n < 0) (primIntToStr n)

impl Eq UInt where
  x == y = primEqUInt x y
  x /= y = not (primEqUInt x y)

impl Ord UInt where
  compare x y = if primLtUInt x y then LT else if primEqUInt x y then EQ else GT
  x < y = primLtUInt x y
  x <= y = primLeUInt x y
  x > y = primLtUInt y x
  x >= y = primLeUInt y x

impl Num UInt where
  x + y = primAddUInt x y
  x - y = primSubUInt x y
  x * y = primMulUInt x y
  negate x = primSubUInt 0 x
  fromInt n = primIntToUInt n

impl Show UInt where
  show n = primIntToStr (primUIntToInt n)

impl Eq Float where
  x == y = primEqFloat x y
  x /= y = not (primEqFloat x y)

impl Ord Float where
  compare x y = if primLtFloat x y then LT else if primEqFloat x y then EQ else GT
  x < y = primLtFloat x y
  x <= y = primLeFloat x y
  x > y = primLtFloat y x
  x >= y = primLeFloat y x

impl Num Float where
  x + y = primAddFloat x y
  x - y = primSubFloat x y
  x * y = primMulFloat x y
  negate x = primNegFloat x
  fromInt n = primIntToFloat n

impl Div Float where
  x / y = primDivFloat x y
  x % y = primSubFloat x (primMulFloat y (primTruncFloat (primDivFloat x y)))

impl Show Float where
  show x = primFloatToStr x
  showPrec d x = showParen (d > 6 && primLtFloat x 0.0) (primFloatToStr x)

impl Eq Char where
  x == y = primEqInt (primCharToInt x) (primCharToInt y)

impl Ord Char where
  x <= y = primLeInt (primCharToInt x) (primCharToInt y)

impl Show Char where
  show c = "'" ++ escapeCodePoint 39 (primCharToInt c) ++ "'"

impl Eq String where
  x == y = primStrEq x y

impl Ord String where
  compare s t = compareFrom s t 0

impl Show String where
  show s = "\"" ++ showChars s 0 ++ "\""

impl Show Unit where
  show _ = "()"

impl (Show a, Show b) => Show (Pair a b) where
  show (MkPair a b) = "(" ++ show a ++ ", " ++ show b ++ ")"

impl Show a => Show (List a) where
  show Nil = "[]"
  show (x :: xs) = "[" ++ show x ++ showElems xs

private showElems : Show a => List a -> String
showElems Nil = "]"
showElems (x :: xs) = ", " ++ show x ++ showElems xs

showParen : Bool -> String -> String
showParen b s = if b then "(" ++ s ++ ")" else s

private compareFrom : String -> String -> Int -> Ordering
compareFrom s t i =
  if i >= strLength s then (if i >= strLength t then EQ else LT)
  else if i >= strLength t then GT
  else if primStrIndex s i < primStrIndex t i then LT
  else if primStrIndex s i > primStrIndex t i then GT
  else compareFrom s t (i + 1)

-- A code point as it is written in a literal delimited by `q`.
private escapeCodePoint : Int -> Int -> String
escapeCodePoint q c =
  if c == q then "\\" ++ primCharToStr (primIntToChar c)
  else if c == 92 then "\\\\"
  else if c == 10 then "\\n"
  else if c == 9 then "\\t"
  else if c == 13 then "\\r"
  else primCharToStr (primIntToChar c)

-- The escaped UTF-8 text of `s` from byte `i`.
private showChars : String -> Int -> String
showChars s i =
  if i >= strLength s then ""
  else
    let n = utf8Len (primStrIndex s i) in
    escapeCodePoint 34 (utf8At s i n) ++ showChars s (i + n)

private utf8Len : Int -> Int
utf8Len b = if b < 128 then 1 else if b < 224 then 2 else if b < 240 then 3 else 4

-- The code point of the `n` bytes at `i`.
private utf8At : String -> Int -> Int -> Int
utf8At s i n =
  if n == 1 then primStrIndex s i
  else if n == 2 then (primStrIndex s i - 192) * 64 + cont s (i + 1)
  else if n == 3 then (primStrIndex s i - 224) * 4096 + cont s (i + 1) * 64 + cont s (i + 2)
  else (primStrIndex s i - 240) * 262144 + cont s (i + 1) * 4096 + cont s (i + 2) * 64 + cont s (i + 3)

private cont : String -> Int -> Int
cont s i = primStrIndex s i - 128

putStrLn : String -> IO ()
putStrLn s = putStr s >> putStr "\n"

-- Prints a value with `show` and a line break.
print : Show a => a -> IO ()
print x = putStrLn (show x)

-- Functions
id : a -> a
id x = x

const : a -> b -> a
const x _ = x

flip : (a -> b -> c) -> b -> a -> c
flip f x y = f y x

(.) : (b -> c) -> (a -> b) -> a -> c
(.) f g x = f (g x)

($) : (a -> b) -> a -> b
f $ x = f x

-- Bool
not : Bool -> Bool
not True = False
not False = True

(&&) : Bool -> Bool -> Bool
True && b = b
False && _ = False

(||) : Bool -> Bool -> Bool
True || _ = True
False || b = b

-- Generic numeric and comparison functions
min : Ord a => a -> a -> a
min x y = if x <= y then x else y

max : Ord a => a -> a -> a
max x y = if x <= y then y else x

abs : (Ord a, Num a) => a -> a
abs x = if x < 0 then negate x else x

-- Float
(+.) : Float -> Float -> Float
x +. y = primAddFloat x y

(-.) : Float -> Float -> Float
x -. y = primSubFloat x y

(*.) : Float -> Float -> Float
x *. y = primMulFloat x y

(/.) : Float -> Float -> Float
x /. y = primDivFloat x y

(==.) : Float -> Float -> Bool
x ==. y = primEqFloat x y

(<.) : Float -> Float -> Bool
x <. y = primLtFloat x y

(<=.) : Float -> Float -> Bool
x <=. y = primLeFloat x y

(>.) : Float -> Float -> Bool
x >. y = primLtFloat y x

(>=.) : Float -> Float -> Bool
x >=. y = primLeFloat y x

negateF : Float -> Float
negateF x = primNegFloat x

sqrt : Float -> Float
sqrt x = primSqrtFloat x

toFloat : Int -> Float
toFloat n = primIntToFloat n

truncate : Float -> Int
truncate x = primFloatToInt x

-- Char and String
ord : Char -> Int
ord c = primCharToInt c

chr : Int -> Char
chr n = primIntToChar n

(++) : String -> String -> String
s ++ t = primStrConcat s t

strLength : String -> Int
strLength s = primStrLength s

strEq : String -> String -> Bool
strEq s t = primStrEq s t

-- Decimal integer (optional leading `-`); stops at the first non-digit.
parseInt : String -> Int
parseInt s =
  if strLength s == 0 then 0
  else if primStrIndex s 0 == 45 then negate (parseDigits s 1 0)
  else parseDigits s 0 0

-- (`&&` evaluates both arguments, so the bounds check is a nested `if`.)
parseDigits : String -> Int -> Int -> Int
parseDigits s i acc =
  if i >= strLength s then acc
  else if isDigit (primStrIndex s i) then parseDigits s (i + 1) (acc * 10 + primStrIndex s i - 48)
  else acc

isDigit : Int -> Bool
isDigit b = b >= 48 && b <= 57

showInt : Int -> String
showInt n = primIntToStr n

showFloat : Float -> String
showFloat x = primFloatToStr x

showChar : Char -> String
showChar c = primCharToStr c

-- Assertions for tests in source files (12-cirkalang.md §11): a failure
-- panics, which fails the test.
assert : Bool -> String -> IO ()
assert b msg = if b then pure () else panic ("assertion failed: " ++ msg)

assertEq : (Eq a, Show a) => a -> a -> IO ()
assertEq x y =
  if x == y then pure ()
  else panic ("assertion failed: " ++ show x ++ " /= " ++ show y)

assertEqInt : Int -> Int -> IO ()
assertEqInt x y = assertEq x y

-- Nat
plus : Nat -> Nat -> Nat
plus Z m = m
plus (S k) m = S (plus k m)

natToInt : Nat -> Int
natToInt Z = 0
natToInt (S k) = 1 + natToInt k

-- Pairs
fst : (a, b) -> a
fst (x, _) = x

snd : (a, b) -> b
snd (_, y) = y

-- Maybe
isJust : Maybe a -> Bool
isJust (Just _) = True
isJust Nothing = False

isNothing : Maybe a -> Bool
isNothing m = not (isJust m)

fromMaybe : a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe _ (Just x) = x

-- The value of `Just`; panics with `msg` on `Nothing`.
expectJust : String -> Maybe a -> a
expectJust _ (Just x) = x
expectJust msg Nothing = panic msg

-- Result (spec-v0.0.2.md §6)
isOk : Result e a -> Bool
isOk (Ok _) = True
isOk (Err _) = False

isErr : Result e a -> Bool
isErr r = not (isOk r)

mapErr : (e -> f) -> Result e a -> Result f a
mapErr f (Err e) = Err (f e)
mapErr _ (Ok x) = Ok x

okOr : e -> Maybe a -> Result e a
okOr e Nothing = Err e
okOr _ (Just x) = Ok x

unwrapOr : a -> Result e a -> a
unwrapOr d (Err _) = d
unwrapOr _ (Ok x) = x

-- The value of `Ok`; panics with the error on `Err`.
unwrap : Show e => Result e a -> a
unwrap (Ok x) = x
unwrap (Err e) = panic ("called `unwrap` on an error: " ++ show e)

-- The value of `Ok`; panics with `msg` and the error on `Err`.
expect : Show e => String -> Result e a -> a
expect _ (Ok x) = x
expect msg (Err e) = panic (msg ++ ": " ++ show e)

-- IO with linear results
pure1 : {a : LType} -> (1 x : a) -> IO1 a
pure1 x = primPure1 x

-- An `IO` action as an `IO1` action.
lift1 : IO a -> IO1 a
lift1 m = primBindTo1 m (\x => primPure1 x)

-- Lists
map : (a -> b) -> List a -> List b
map f Nil = Nil
map f (x :: xs) = f x :: map f xs

filter : (a -> Bool) -> List a -> List a
filter p Nil = Nil
filter p (x :: xs) = if p x then x :: filter p xs else filter p xs

foldl : (b -> a -> b) -> b -> List a -> b
foldl f z Nil = z
foldl f z (x :: xs) = foldl f (f z x) xs

foldr : (a -> b -> b) -> b -> List a -> b
foldr f z Nil = z
foldr f z (x :: xs) = f x (foldr f z xs)

length : List a -> Int
length xs = foldl (\n, _ => n + 1) 0 xs

sum : Num a => List a -> a
sum xs = foldl (\a, b => a + b) 0 xs

product : Num a => List a -> a
product xs = foldl (\a, b => a * b) 1 xs

reverse : List a -> List a
reverse xs = foldl (\acc, x => x :: acc) Nil xs

append : List a -> List a -> List a
append Nil ys = ys
append (x :: xs) ys = x :: append xs ys

range : Int -> Int -> List Int
range a b = if a > b then Nil else a :: range (a + 1) b

concat : List (List a) -> List a
concat xss = foldr append Nil xss

concatMap : (a -> List b) -> List a -> List b
concatMap f xs = concat (map f xs)

mapM_ : Monad m => (a -> m ()) -> List a -> m ()
mapM_ f Nil = pure ()
mapM_ f (x :: xs) = f x >>= \_ => mapM_ f xs

-- ---- Proofs (spec-v0.0.4.md §2) ----

total
sym : {0 x : a} -> {0 y : a} -> x = y -> y = x
sym Refl = Refl

total
trans : {0 x : a} -> {0 y : a} -> {0 z : a} -> x = y -> y = z -> x = z
trans Refl Refl = Refl

total
cong : {0 x : a} -> {0 y : a} -> (0 f : a -> b) -> x = y -> f x = f y
cong f Refl = Refl

-- Anything follows from an impossible value.
total
absurd : Void -> a
absurd v = case v of {}

-- `So b` from `b = True`, and back.
total
soTrue : So b -> b = True
soTrue Oh = Refl

-- `--contracts=check` (spec-v0.0.4.md §4.3): a refinement that could not be
-- proved is checked at run time.
checkContract : (p : a -> Bool) -> String -> a -> a
checkContract p msg x = if p x then x else panic msg

-- Division by a divisor proved non-zero: no zero check at run time
-- (spec-v0.0.4.md §5).
divNZ : Int -> {d : Int | d /= 0} -> Int
divNZ n d = primDivProved n d

modNZ : Int -> {d : Int | d /= 0} -> Int
modNZ n d = primModProved n d

-- A branch proved impossible (its path conditions contradict each other).
unreachable : {u : () | False} -> a
unreachable u = primUnreachable u
