-- The C foreign function interface (spec-v0.0.2.md §8, spec-v0.0.6.md §1).
--
-- The C types are wrappers of `Int` / `Float`: a value is converted to
-- the C type (its low bits) when it is passed to C, and a result from C
-- is extended to 64 bits. `Ptr a` is an address; reading and writing
-- through it is not checked (as in C).
module Foreign

import Data.Array.Unboxed (UArray)

data CChar = MkCChar Int deriving (Eq, Ord, Show)
data CUChar = MkCUChar Int deriving (Eq, Ord, Show)
data CShort = MkCShort Int deriving (Eq, Ord, Show)
data CUShort = MkCUShort Int deriving (Eq, Ord, Show)
data CInt = MkCInt Int deriving (Eq, Ord, Show)
data CUInt = MkCUInt Int deriving (Eq, Ord, Show)
data CLong = MkCLong Int deriving (Eq, Ord, Show)
data CULong = MkCULong Int deriving (Eq, Ord, Show)
data CSize = MkCSize Int deriving (Eq, Ord, Show)
data CSSize = MkCSSize Int deriving (Eq, Ord, Show)
data CFloat = MkCFloat Float deriving (Eq, Ord, Show)
data CDouble = MkCDouble Float deriving (Eq, Ord, Show)
-- `_Bool` (`bool`): 0 or 1.
data CBool = MkCBool Int deriving (Eq, Ord, Show)

-- Conversions (the low bits are kept when a value is passed to C).
fromCInt : CInt -> Int
fromCInt (MkCInt n) = n

fromCLong : CLong -> Int
fromCLong (MkCLong n) = n

fromCSize : CSize -> Int
fromCSize (MkCSize n) = n

fromCDouble : CDouble -> Float
fromCDouble (MkCDouble x) = x

-- An address of C memory holding `a`s.
data Ptr (a : Type) = MkPtr Int

-- The address of a C function of type `f` (a type of extern functions,
-- spec-v0.0.6.md §1.5).
data FunPtr (f : Type) = MkFunPtr Int

-- A C array `a[n]`, the type of a field of a structure (spec-v0.0.6.md
-- §1.2). It is written as `n` elements: a longer list is cut, a shorter
-- one is filled with `zeroed`.
data CArray (n : Int) (a : Type) = MkCArray (List a)

-- Addresses compare whatever they point to.
impl Eq (Ptr a) where
  (MkPtr p) == (MkPtr q) = p == q

impl Ord (Ptr a) where
  compare (MkPtr p) (MkPtr q) = compare p q

impl Show (Ptr a) where
  showPrec d (MkPtr p) = showParen (d > 10) ("MkPtr " ++ showPrec 11 p)

impl Eq (FunPtr f) where
  (MkFunPtr p) == (MkFunPtr q) = p == q

impl Ord (FunPtr f) where
  compare (MkFunPtr p) (MkFunPtr q) = compare p q

impl Show (FunPtr f) where
  showPrec d (MkFunPtr p) = showParen (d > 10) ("MkFunPtr " ++ showPrec 11 p)

-- Arrays are equal when their C values are: `n` elements, cut or filled
-- with `zeroed` (as `poke` writes them).
impl {n : Int} -> (Eq a, Storable a) => Eq (CArray n a) where
  (MkCArray xs) == (MkCArray ys) = resize n xs == resize n ys

-- `n` elements of the list: cut, or filled with `zeroed`.
resize : Storable a => Int -> List a -> List a
resize n xs = if n <= 0 then Nil else case xs of
  Nil => zeroed :: resize (n - 1) Nil
  x :: rest => x :: resize (n - 1) rest

impl Show a => Show (CArray n a) where
  showPrec d (MkCArray xs) = showParen (d > 10) ("MkCArray " ++ showPrec 11 xs)

-- An address that must be given back to C exactly once (a linear value;
-- wrap it in a type with `Release` that frees it).
data OwnedPtr (a : Type) : LType where
  MkOwnedPtr : Int -> OwnedPtr a

-- An object of the runtime (a socket, a remote of an event loop) that
-- `extern "cirka"` functions take and return (spec-v0.0.5.md §2.1): the
-- libraries wrap it in their own types. It is counted like any value and
-- freed with its last use.
prim Handle : Type

nullPtr : Ptr a
nullPtr = MkPtr 0

isNull : Ptr a -> Bool
isNull (MkPtr p) = p == 0

plusPtr : Ptr a -> Int -> Ptr b
plusPtr (MkPtr p) n = MkPtr (p + n)

castPtr : Ptr a -> Ptr b
castPtr (MkPtr p) = MkPtr p

ptrAddress : Ptr a -> Int
ptrAddress (MkPtr p) = p

nullFunPtr : FunPtr f
nullFunPtr = MkFunPtr 0

castFunPtr : FunPtr f -> FunPtr g
castFunPtr (MkFunPtr p) = MkFunPtr p

funPtrAddress : FunPtr f -> Int
funPtrAddress (MkFunPtr p) = p

castFunPtrToPtr : FunPtr f -> Ptr a
castFunPtrToPtr (MkFunPtr p) = MkPtr p

castPtrToFunPtr : Ptr a -> FunPtr f
castPtrToFunPtr (MkPtr p) = MkFunPtr p

private extern "C" where
  malloc : CSize -> IO (Ptr CChar)
  free : Ptr CChar -> IO ()
  strlen : Ptr CChar -> IO CSize

private extern "cirka" where
  cirka_mem_read : Int -> Int -> IO Int
  cirka_mem_write : Int -> Int -> Int -> IO ()
  cirka_mem_read_f : Int -> Int -> IO Float
  cirka_mem_write_f : Int -> Int -> Float -> IO ()
  cirka_cstring_new : String -> IO Int
  cirka_cstring_peek : Int -> Int -> IO String
  cirka_callback_free : Int -> IO ()

-- ---- function pointers made from functions (spec-v0.0.6.md §1.5) ----

-- Frees a function pointer made by a `"wrapper"` function. Calling it
-- from C afterwards is an error of the program (as with freed memory).
freeFunPtr : FunPtr f -> IO ()
freeFunPtr (MkFunPtr p) = cirka_callback_free p

-- A function pointer made by a `"wrapper"` function, freed when it is
-- released: `cb <- callback (mkVisitor visit)`.
data Callback (f : Type) : LType where
  MkCallback : FunPtr f -> Callback f

impl Release (Callback f) where
  release (MkCallback p) = freeFunPtr p

callback : IO (FunPtr f) -> IO1 (Callback f)
callback mk = do
  p <- mk
  pure1 (MkCallback p)

-- The pointer, to give to C while the callback is not released.
callbackPtr : (1 c : Callback f) -> (Callback f, FunPtr f)
callbackPtr (MkCallback p) = (MkCallback p, p)

-- `n` bytes of C memory (not initialized), freed with `freeBytes`.
mallocBytes : Int -> IO (Ptr a)
mallocBytes n = do
  p <- malloc (MkCSize n)
  pure (castPtr p)

freeBytes : Ptr a -> IO ()
freeBytes p = free (castPtr p)

-- Calls `f` with a NUL-terminated copy of `s` (freed after `f`).
withCString : String -> (Ptr CChar -> IO b) -> IO b
withCString s f = do
  p <- cirka_cstring_new s
  r <- f (MkPtr p)
  free (MkPtr p)
  pure r

-- The bytes of a NUL-terminated C string.
peekCString : Ptr CChar -> IO String
peekCString (MkPtr p) = do
  n <- strlen (MkPtr p)
  peekCStringLen (MkPtr p) (fromCSize n)

-- `n` bytes at the address.
peekCStringLen : Ptr CChar -> Int -> IO String
peekCStringLen (MkPtr p) n = cirka_cstring_peek p n

-- Integers in memory: `peekInt8` ... (kinds as in `cirka_mem_read`).
peekByte : Ptr a -> Int -> IO Int
peekByte (MkPtr p) i = cirka_mem_read (p + i) 1

pokeByte : Ptr a -> Int -> Int -> IO ()
pokeByte (MkPtr p) i v = cirka_mem_write (p + i) 1 v

peekInt32 : Ptr a -> Int -> IO Int
peekInt32 (MkPtr p) i = cirka_mem_read (p + i * 4) 4

pokeInt32 : Ptr a -> Int -> Int -> IO ()
pokeInt32 (MkPtr p) i v = cirka_mem_write (p + i * 4) 4 v

peekInt64 : Ptr a -> Int -> IO Int
peekInt64 (MkPtr p) i = cirka_mem_read (p + i * 8) 6

pokeInt64 : Ptr a -> Int -> Int -> IO ()
pokeInt64 (MkPtr p) i v = cirka_mem_write (p + i * 8) 6 v

-- ---- Storable (spec-v0.0.6.md §1.2) ----

-- Values with a C representation in memory. The type of `sizeOf` and
-- `alignment` is given by a pointer, which is not read:
-- `sizeOf (nullPtr : Ptr CInt)`. Reading and writing are not checked.
trait Storable a where
  -- The size in bytes.
  sizeOf : Ptr a -> Int
  alignment : Ptr a -> Int
  peek : Ptr a -> IO a
  poke : Ptr a -> a -> IO ()
  -- The value whose bytes are all 0 (C's `{0}`).
  zeroed : a

-- Integers (`kind` of `cirka_mem_read`) and floating point numbers
-- (0 `float`, 1 `double`) at an address.
private peekI : Int -> Ptr a -> IO Int
peekI k (MkPtr p) = cirka_mem_read p k

private pokeI : Int -> Ptr a -> Int -> IO ()
pokeI k (MkPtr p) v = cirka_mem_write p k v

private peekF : Int -> Ptr a -> IO Float
peekF k (MkPtr p) = cirka_mem_read_f p k

private pokeF : Int -> Ptr a -> Float -> IO ()
pokeF k (MkPtr p) v = cirka_mem_write_f p k v

impl Storable CChar where
  sizeOf _ = 1
  alignment _ = 1
  peek p = fmap MkCChar (peekI 0 p)
  poke p (MkCChar v) = pokeI 0 p v
  zeroed = MkCChar 0

impl Storable CUChar where
  sizeOf _ = 1
  alignment _ = 1
  peek p = fmap MkCUChar (peekI 1 p)
  poke p (MkCUChar v) = pokeI 1 p v
  zeroed = MkCUChar 0

impl Storable CShort where
  sizeOf _ = 2
  alignment _ = 2
  peek p = fmap MkCShort (peekI 2 p)
  poke p (MkCShort v) = pokeI 2 p v
  zeroed = MkCShort 0

impl Storable CUShort where
  sizeOf _ = 2
  alignment _ = 2
  peek p = fmap MkCUShort (peekI 3 p)
  poke p (MkCUShort v) = pokeI 3 p v
  zeroed = MkCUShort 0

impl Storable CInt where
  sizeOf _ = 4
  alignment _ = 4
  peek p = fmap MkCInt (peekI 4 p)
  poke p (MkCInt v) = pokeI 4 p v
  zeroed = MkCInt 0

impl Storable CUInt where
  sizeOf _ = 4
  alignment _ = 4
  peek p = fmap MkCUInt (peekI 5 p)
  poke p (MkCUInt v) = pokeI 5 p v
  zeroed = MkCUInt 0

impl Storable CLong where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap MkCLong (peekI 6 p)
  poke p (MkCLong v) = pokeI 6 p v
  zeroed = MkCLong 0

impl Storable CULong where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap MkCULong (peekI 6 p)
  poke p (MkCULong v) = pokeI 6 p v
  zeroed = MkCULong 0

impl Storable CSize where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap MkCSize (peekI 6 p)
  poke p (MkCSize v) = pokeI 6 p v
  zeroed = MkCSize 0

impl Storable CSSize where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap MkCSSize (peekI 6 p)
  poke p (MkCSSize v) = pokeI 6 p v
  zeroed = MkCSSize 0

impl Storable CFloat where
  sizeOf _ = 4
  alignment _ = 4
  peek p = fmap MkCFloat (peekF 0 p)
  poke p (MkCFloat v) = pokeF 0 p v
  zeroed = MkCFloat 0.0

impl Storable CDouble where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap MkCDouble (peekF 1 p)
  poke p (MkCDouble v) = pokeF 1 p v
  zeroed = MkCDouble 0.0

impl Storable CBool where
  sizeOf _ = 1
  alignment _ = 1
  peek p = fmap MkCBool (peekI 1 p)
  poke p (MkCBool v) = pokeI 1 p v
  zeroed = MkCBool 0

-- `int64_t`, `uint64_t` and `double`.
impl Storable Int where
  sizeOf _ = 8
  alignment _ = 8
  peek p = peekI 6 p
  poke p v = pokeI 6 p v
  zeroed = 0

impl Storable UInt where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap primIntToUInt (peekI 6 p)
  poke p v = pokeI 6 p (primUIntToInt v)
  zeroed = primIntToUInt 0

impl Storable Float where
  sizeOf _ = 8
  alignment _ = 8
  peek p = peekF 1 p
  poke p v = pokeF 1 p v
  zeroed = 0.0

impl Storable (Ptr b) where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap MkPtr (peekI 6 p)
  poke p (MkPtr v) = pokeI 6 p v
  zeroed = nullPtr

impl Storable (FunPtr f) where
  sizeOf _ = 8
  alignment _ = 8
  peek p = fmap MkFunPtr (peekI 6 p)
  poke p (MkFunPtr v) = pokeI 6 p v
  zeroed = nullFunPtr

impl {n : Int} -> Storable a => Storable (CArray n a) where
  sizeOf _ = n * sizeOf (nullPtr : Ptr a)
  alignment _ = alignment (nullPtr : Ptr a)
  peek p = fmap MkCArray (peekArray n (castPtr p))
  poke p (MkCArray xs) = pokeArrayN (castPtr p) n xs
  zeroed = MkCArray (zeroedList n)

-- Writes exactly `n` elements: the list cut, or filled with `zeroed`.
pokeArrayN : Storable a => Ptr a -> Int -> List a -> IO ()
pokeArrayN p n xs = pokeArrayFill p 0 n xs

private pokeArrayFill : Storable a => Ptr a -> Int -> Int -> List a -> IO ()
pokeArrayFill p i n xs = if i >= n then pure () else case xs of
  Nil => do
    pokeElemOff p i zeroed
    pokeArrayFill p (i + 1) n Nil
  x :: rest => do
    pokeElemOff p i x
    pokeArrayFill p (i + 1) n rest

-- `n` times `zeroed`.
zeroedList : Storable a => Int -> List a
zeroedList n = if n <= 0 then Nil else zeroed :: zeroedList (n - 1)

-- ---- the code of extern blocks (spec-v0.0.6.md §1.9) ----

-- The layout of a C structure or union (the type pointed to, which is not
-- read): `primCLayout p 0` is its size, `1` its alignment and `2 + i`
-- the offset of field `i`. The compiler computes it as C does.
prim primCLayout : {a : Type} -> Ptr a -> Int -> Int

-- The value at address `a + off`.
peekField : Storable b => Int -> Int -> IO b
peekField a off = peek (MkPtr (a + off))

pokeField : Storable b => Int -> Int -> b -> IO ()
pokeField a off x = poke (MkPtr (a + off)) x

-- The element `i` elements after the address.
peekElemOff : Storable a => Ptr a -> Int -> IO a
peekElemOff p i = peek (advancePtr p i)

pokeElemOff : Storable a => Ptr a -> Int -> a -> IO ()
pokeElemOff p i x = poke (advancePtr p i) x

-- The address `i` elements after `p`.
advancePtr : Storable a => Ptr a -> Int -> Ptr a
advancePtr p i = plusPtr p (i * sizeOf p)

-- `n` elements from the address.
peekArray : Storable a => Int -> Ptr a -> IO (List a)
peekArray n p = peekDown p (n - 1) Nil

private peekDown : Storable a => Ptr a -> Int -> List a -> IO (List a)
peekDown p i acc = if i < 0 then pure acc else do
  x <- peekElemOff p i
  peekDown p (i - 1) (x :: acc)

-- Writes the elements from the address.
pokeArray : Storable a => Ptr a -> List a -> IO ()
pokeArray p xs = pokeUp p 0 xs

private pokeUp : Storable a => Ptr a -> Int -> List a -> IO ()
pokeUp _ _ Nil = pure ()
pokeUp p i (x :: xs) = do
  pokeElemOff p i x
  pokeUp p (i + 1) xs

-- Memory for `n` elements (not initialized), freed with `freeBytes`.
mallocArray : Storable a => Int -> IO (Ptr a)
mallocArray n = mallocFor nullPtr n

private mallocFor : Storable a => Ptr a -> Int -> IO (Ptr a)
mallocFor z n = mallocBytes (n * sizeOf z)

-- Calls `f` with memory for one value (not initialized), freed after `f`.
alloca : Storable a => (Ptr a -> IO b) -> IO b
alloca f = allocaArray 1 f

-- Calls `f` with memory for `n` values (not initialized), freed after `f`.
allocaArray : Storable a => Int -> (Ptr a -> IO b) -> IO b
allocaArray n f = do
  p <- mallocArray n
  r <- f p
  freeBytes p
  pure r

-- Calls `f` with a copy of `x` in memory, freed after `f`.
withValue : Storable a => a -> (Ptr a -> IO b) -> IO b
withValue x f = alloca (pokeThen x f)

private pokeThen : Storable a => a -> (Ptr a -> IO b) -> Ptr a -> IO b
pokeThen x f p = do
  poke p x
  f p

-- Calls `f` with the elements in memory, freed after `f`.
withArray : Storable a => List a -> (Ptr a -> IO b) -> IO b
withArray xs f = allocaArray (length xs) (pokeArrayThen xs f)

private pokeArrayThen : Storable a => List a -> (Ptr a -> IO b) -> Ptr a -> IO b
pokeArrayThen xs f p = do
  pokeArray p xs
  f p

-- ---- unboxed arrays (spec-v0.0.6.md §4.3) ----

private prim primUArrayStore : {a : Type} -> UArray a -> Int -> IO ()
private prim primUArrayLoad : {a : Type} -> Int -> Int -> IO (UArray a)
private prim primUArrayLoadInto : {a : Type} -> UArray a -> Int -> IO (UArray a)

-- Writes the elements of `arr` from `p` on, 8 bytes each (an `Int` as an
-- `int64_t`, a `Float` as a `double`), in one copy.
pokeUArray : Ptr a -> UArray a -> IO ()
pokeUArray (MkPtr p) arr = primUArrayStore arr p

-- The array of the `n` elements from `p` on, 8 bytes each, in one copy.
peekUArray : Int -> Ptr a -> IO (UArray a)
peekUArray n (MkPtr p) = primUArrayLoad (max n 0) p

-- The array of `size arr` elements from `p` on, as `peekUArray`, stored in
-- `arr` itself when no other value shares it (otherwise in a copy).
peekUArrayInto : UArray a -> Ptr a -> IO (UArray a)
peekUArrayInto arr (MkPtr p) = primUArrayLoadInto arr p
