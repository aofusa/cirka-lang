module Main

-- spectral-norm (Benchmarks Game), single-threaded. The vectors are
-- unboxed arrays (Data.Array.Unboxed), like the Vec<f64> of rust/main.rs
-- (FEAT-0091; v0.0.1 had no arrays and used lists, whose elements are
-- boxes); the indices are proved in bounds. Same output as rust/main.rs.

import Data.Array.Unboxed as U

a : Int -> Int -> Float
a i j = 1.0 /. toFloat ((i + j) * (i + j + 1) / 2 + i + 1)

-- Sum over k in [k, size u) of A(i, k) * u[k], or of A(k, i) when `t`.
dot : Bool -> Int -> (k : Int) -> (u : U.UArray Float) -> Float -> Float
  requires 0 <= k
dot t i k u s =
  if k >= U.size u then s
  else dot t i (k + 1) u (s +. (if t then a k i else a i k) *. U.index u k)

-- A u, or the transpose of A times u when `t`.
mulAv : Bool -> U.UArray Float -> U.UArray Float
mulAv t u = U.generate (U.size u) (\i => dot t i 0 u 0.0)

mulAtAv : U.UArray Float -> U.UArray Float
mulAtAv u = mulAv True (mulAv False u)

power : Int -> U.UArray Float -> Pair (U.UArray Float) (U.UArray Float)
power k u =
  let v = mulAtAv u in
  let u2 = mulAtAv v in
  if k <= 1 then (u2, v) else power (k - 1) u2

-- Sum over i from i of x[i] * y[i], up to the shorter size.
dot2 : (i : Int) -> (x : U.UArray Float) -> (y : U.UArray Float) -> Float -> Float
  requires 0 <= i
dot2 i x y s =
  if i >= U.size x then s
  else if i >= U.size y then s
  else dot2 (i + 1) x y (s +. U.index x i *. U.index y i)

pad9 : String -> String
pad9 s = if strLength s < 9 then pad9 ("0" ++ s) else s

fixed9 : Float -> String
fixed9 x =
  if x <. 0.0 then "-" ++ fixed9 (negateF x)
  else
    let n = truncate (x *. 1000000000.0 +. 0.5) in
    showInt (n / 1000000000) ++ "." ++ pad9 (showInt (n % 1000000000))

main : IO ()
main = do
  argc <- argCount
  arg <- if argc > 0 then getArg 0 else pure "100"
  let n = parseInt arg
  case power 10 (U.generate n (\i => 1.0)) of
    (u, v) => putStrLn (fixed9 (sqrt (dot2 0 u v 0.0 /. dot2 0 v v 0.0)))
