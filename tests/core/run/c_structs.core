; C structs and unions by value (FEAT-0047, 08-ffi.md §7.2): aggregates in
; integer and SSE registers, in memory (`byval` arguments, `sret` results),
; aggregates that do not fit in the registers left, a packed struct, a
; union, and calls through function pointers. The C side is c_structs.c.
(cstruct pair_i (i32 i32))
(cstruct pair_l (i64 i64))
(cstruct vec2 (f64 f64))
(cstruct vec3 (f32 f32 f32))
(cstruct mixed (f32 i32 f64))
(cstruct big (i64 i64 i64))
(cstruct three (u8 u8 u8))
(cunion clear ((array f32 4) (array i32 4)))
(cstruct packed :packed (u8 u32))
(extern cirka_write_i64 (Int#) Unit#)
(extern cirka_write_f64 (Double#) Unit#)
(extern cirka_write_char (Int#) Unit#)
(extern cirka_mem_read (Int# Int#) Int#)
(extern cirka_mem_write (Int# Int# Int#) Unit#)
(extern cirka_mem_read_f (Int# Int#) Double#)
(extern cirka_mem_write_f (Int# Int# Double#) Unit#)
(extern malloc (Int#) Int# (c (u64) ptr))
(extern free (Int#) Unit# (c (ptr) void))
(extern cs_sum_pair_i (Int#) Int# (c (pair_i) i64))
(extern cs_make_pair_l (Int# Int# Int#) Unit# (c (i64 i64) pair_l))
(extern ldiv (Int# Int# Int#) Unit# (c (i64 i64) pair_l))
(extern cs_dot (Int# Int#) Double# (c (vec2 vec2) f64))
(extern cs_scale3 (Int# Int# Double#) Unit# (c (vec3 f32) vec3))
(extern cs_mixed (Int# Int#) Unit# (c (mixed) mixed))
(extern cs_big_add (Int# Int# Int#) Unit# (c (big big) big))
(extern cs_three (Int#) Int# (c (three) i64))
(extern cs_clear_bits (Int#) Int# (c (clear) i64))
(extern cs_packed_v (Int#) Int# (c (packed) u32))
(extern cs_many (Int# Int# Int# Int# Int# Int# Int#) Int# (c (i64 i64 i64 i64 i64 pair_l i64) i64))
(extern cs_many_f (Double# Double# Double# Double# Double# Double# Double# Int# Double#) Double#
  (c (f64 f64 f64 f64 f64 f64 f64 vec2 f64) f64))
; The same functions through their addresses.
(extern dot_addr () Int# (c (vec2 vec2) f64) :addr :link cs_dot)
(extern dot_at (Int# Int# Int#) Double# (c (vec2 vec2) f64) :dynamic)
(extern big_addr () Int# (c (big big) big) :addr :link cs_big_add)
(extern big_at (Int# Int# Int# Int#) Unit# (c (big big) big) :dynamic)

(def pi (-> Int# Unit#)
  (lam ((n Int#)) (let! (u Unit# (extern cirka_write_i64 n)) (extern cirka_write_char 10))))
(def pf (-> Double# Unit#)
  (lam ((x Double#)) (let! (u Unit# (extern cirka_write_f64 x)) (extern cirka_write_char 10))))
; Memory at p + off: kinds of cirka_mem_* (1 u8, 4 i32, 6 i64; 0 float, 1 double).
(def w (-> Int# Int# Int# Int# Unit#)
  (lam ((k Int#) (p Int#) (off Int#) (v Int#)) (extern cirka_mem_write (prim add p off) k v)))
(def r (-> Int# Int# Int# Int#)
  (lam ((k Int#) (p Int#) (off Int#)) (extern cirka_mem_read (prim add p off) k)))
(def wf (-> Int# Int# Int# Double# Unit#)
  (lam ((k Int#) (p Int#) (off Int#) (v Double#)) (extern cirka_mem_write_f (prim add p off) k v)))
(def rf (-> Int# Int# Int# Double#)
  (lam ((k Int#) (p Int#) (off Int#)) (extern cirka_mem_read_f (prim add p off) k)))

