; Variadic C functions (FEAT-0047, 08-ffi.md §7.2): the C signature lists
; the fixed parameters, `...` and the types of the variadic arguments of
; one call, and `:link` points several such declarations at the same C
; function. Arguments beyond the registers go to the stack in order,
; structures included; a variadic function is also called through its
; address. The C side is c_varargs.c; `snprintf` is the C library's.
(cstruct pair_l (i64 i64))
(cstruct vec2 (f64 f64))
(cstruct big (i64 i64 i64))
(extern cirka_write_i64 (Int#) Unit#)
(extern cirka_write_char (Int#) Unit#)
(extern cirka_write_bytes (Bytes) Unit#)
(extern cirka_cstring_new (Bytes) Int#)
(extern cirka_cstring_peek (Int# Int#) Bytes)
(extern cirka_errno () Int#)
(extern cirka_mem_write (Int# Int# Int#) Unit#)
(extern cirka_mem_write_f (Int# Int# Double#) Unit#)
(extern malloc (Int#) Int# (c (u64) ptr))
(extern free (Int#) Unit# (c (ptr) void))
(extern fmt1 (Int# Int# Int# Int# Int# Int#) Int# (c (ptr u64 ptr ... i32 u32 i32) i32) :link snprintf)
(extern fmt2 (Int# Int# Int# Int# Int# Double# Double#) Int# (c (ptr u64 ptr ... i64 ptr f64 f64) i32) :link snprintf)
(extern fmt10f (Int# Int# Int# Double# Double# Double# Double# Double# Double# Double# Double# Double# Double#) Int# (c (ptr u64 ptr ... f64 f64 f64 f64 f64 f64 f64 f64 f64 f64) i32) :link snprintf)
(extern fmt8i (Int# Int# Int# Int# Int# Int# Int# Int# Int# Int# Int#) Int# (c (ptr u64 ptr ... i64 i64 i64 i64 i64 i64 i64 i64) i32) :link snprintf)
(extern fmt_mixed (Int# Int# Int# Int# Double# Int# Double# Int# Double# Int# Double# Int# Double# Int# Double# Int# Double# Int# Double# Int# Double# Int# Double#) Int# (c (ptr u64 ptr ... i32 f64 i32 f64 i32 f64 i32 f64 i32 f64 i32 f64 i32 f64 i32 f64 i32 f64 i32 f64) i32) :link snprintf)
(extern snprintf_addr () Int# (c (ptr u64 ptr ...) i32) :addr :link snprintf)
(extern fmt_at (Int# Int# Int# Int# Int# Double#) Int# (c (ptr u64 ptr ... i64 f64) i32) :dynamic)
(extern sum8 (Int# Int# Int# Int# Int# Int# Int# Int# Int#) Int# (c (i32 ... i64 i64 i64 i64 i64 i64 i64 i64) i64) :link cv_sum)
(extern sum0 (Int#) Int# (c (i32 ...) i64) :link cv_sum)
(extern fsum10 (Int# Double# Double# Double# Double# Double# Double# Double# Double# Double# Double#) Int# (c (i32 ... f64 f64 f64 f64 f64 f64 f64 f64 f64 f64) i64) :link cv_fsum)
(extern mix (Int# Int# Int# Double# Int# Int# Int#) Int# (c (ptr ... i64 pair_l f64 vec2 big i64) i64) :link cv_mix)
(extern mix_spill (Int# Int# Int# Int# Int# Int# Int#) Int# (c (ptr ... i64 i64 i64 i64 pair_l i64) i64) :link cv_mix)
(extern mix_fspill (Int# Double# Double# Double# Double# Double# Double# Double# Int# Double#) Int# (c (ptr ... f64 f64 f64 f64 f64 f64 f64 vec2 f64) i64) :link cv_mix)
(extern cv_fail (Int#) Int# (c (i32) i32))

(def pi (-> Int# Unit#)
  (lam ((n Int#)) (let! (u Unit# (extern cirka_write_i64 n)) (extern cirka_write_char 10))))
; The n bytes written at buf, and a newline.
(def show (-> Int# Int# Unit#)
  (lam ((buf Int#) (n Int#))
    (let! (s Bytes (extern cirka_cstring_peek buf n))
    (let! (u Unit# (extern cirka_write_bytes s))
      (extern cirka_write_char 10)))))
(def w (-> Int# Int# Int# Unit#)
  (lam ((p Int#) (off Int#) (v Int#)) (extern cirka_mem_write (prim add p off) 6 v)))
(def wf (-> Int# Int# Double# Unit#)
  (lam ((p Int#) (off Int#) (v Double#)) (extern cirka_mem_write_f (prim add p off) 1 v)))

(def main Int#
  (let! (buf Int# (extern malloc 256))
  (let! (p Int# (extern malloc 64))
  (let! (v Int# (prim add p 16))
  (let! (b Int# (prim add p 32))
  (let! (f1 Int# (extern cirka_cstring_new "%d|%u|%c"))
  (let! (f2 Int# (extern cirka_cstring_new "%ld %s %.3f %e"))
  (let! (str Int# (extern cirka_cstring_new "str"))
  (let! (f10 Int# (extern cirka_cstring_new "%g %g %g %g %g %g %g %g %g %g"))
