; skip-backend: interp
; C callbacks (FEAT-0047, 08-ffi.md §7.2): `:callback h` makes a C function
; pointer of a closure (the environment, here `Env`) that calls the handler
; `h`; `cirka_callback_free` frees it and drops the environment. Callbacks
; with structures in memory and in registers, arguments on the stack,
; narrow integers, a callback calling C calling a callback, the C
; library's `qsort` with a comparison of the closure, and more callbacks
; made and freed than the stubs. The interpreter cannot be re-entered from
; C, so this runs natively only. The C side is c_callbacks.c.
(data Env () (Env Int#))
(cstruct big (i64 i64 i64))
(cstruct vec3 (f32 f32 f32))
(extern cirka_write_i64 (Int#) Unit#)
(extern cirka_write_f64 (Double#) Unit#)
(extern cirka_write_char (Int#) Unit#)
(extern cirka_mem_read (Int# Int#) Int#)
(extern cirka_mem_write (Int# Int# Int#) Unit#)
(extern cirka_mem_read_f (Int# Int#) Double#)
(extern cirka_mem_write_f (Int# Int# Double#) Unit#)
(extern cirka_callback_free (Int#) Unit#)
(extern malloc (Int#) Int# (c (u64) ptr))
(extern free (Int#) Unit# (c (ptr) void))
(extern qsort (Int# Int# Int# Int#) Unit# (c (ptr u64 u64 ptr) void))
(extern cb_each (Int# Int#) Int# (c (ptr i64) i64))
(extern cb_big (Int#) Int# (c (ptr) i64))
(extern cb_vec3 (Int#) Double# (c (ptr) f64))
(extern cb_many (Int#) Double# (c (ptr) f64))
(extern cb_narrow (Int#) Int# (c (ptr) i64))
(extern cb_nested (Int# Int#) Int# (c (ptr ptr) i64))
(extern times (Env) Int# (c (i64) i64) :callback h_times)
(extern big_cb (Env) Int# (c (big i64) big) :callback h_big)
(extern vec3_cb (Env) Int# (c (vec3 f32) vec3) :callback h_vec3)
(extern many_cb (Env) Int# (c (i64 i64 i64 i64 i64 i64 i64 i64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64) f64)
  :callback h_many)
(extern narrow_cb (Env) Int# (c (u8 i16 u32) i8) :callback h_narrow)
(extern outer_cb (Env) Int# (c (ptr i64) i64) :callback h_outer)
(extern cmp_cb (Env) Int# (c (ptr ptr) i32) :callback h_cmp)

(def pi (-> Int# Unit#)
  (lam ((n Int#)) (let! (u Unit# (extern cirka_write_i64 n)) (extern cirka_write_char 10))))
(def pf (-> Double# Unit#)
  (lam ((x Double#)) (let! (u Unit# (extern cirka_write_f64 x)) (extern cirka_write_char 10))))
(def k (-> Env Int#)
  (lam ((e Env)) (case e (s Env) Int# ((Env n) n))))
(def r (-> Int# Int# Int#)
  (lam ((p Int#) (off Int#)) (extern cirka_mem_read (prim add p off) 6)))
(def w (-> Int# Int# Int# Unit#)
  (lam ((p Int#) (off Int#) (v Int#)) (extern cirka_mem_write (prim add p off) 6 v)))
(def rf (-> Int# Int# Double#)
  (lam ((p Int#) (off Int#)) (extern cirka_mem_read_f (prim add p off) 0)))
(def wf (-> Int# Int# Double# Unit#)
  (lam ((p Int#) (off Int#) (v Double#)) (extern cirka_mem_write_f (prim add p off) 0 v)))

; x * k
(def h_times (-> Env Int# Int#)
  (lam ((e Env) (x Int#)) (prim mul x (k e))))
; Each field times k, plus n; the result is written at out.
(def h_big (-> Env Int# Int# Int# Unit#)
  (lam ((e Env) (out Int#) (b Int#) (n Int#))
    (let! (m Int# (k e))
    (let! (u1 Unit# (w out 0 (prim add (prim mul (r b 0) m) n)))
    (let! (u2 Unit# (w out 8 (prim add (prim mul (r b 8) m) n)))
      (w out 16 (prim add (prim mul (r b 16) m) n)))))))
; Each coordinate times f, plus k.
(def h_vec3 (-> Env Int# Int# Double# Unit#)
  (lam ((e Env) (out Int#) (v Int#) (f Double#))
    (let! (m Double# (prim int_to_double (k e)))
    (let! (u1 Unit# (wf out 0 (prim fadd (prim fmul (rf v 0) f) m)))
    (let! (u2 Unit# (wf out 4 (prim fadd (prim fmul (rf v 4) f) m)))
      (wf out 8 (prim fadd (prim fmul (rf v 8) f) m)))))))
; The integers as digits, times 1000, plus the sum of i * d_i.
(def h_many (-> Env Int# Int# Int# Int# Int# Int# Int# Int# Double# Double# Double# Double# Double# Double# Double# Double# Double# Double# Double#)
  (lam ((e Env) (a1 Int#) (a2 Int#) (a3 Int#) (a4 Int#) (a5 Int#) (a6 Int#) (a7 Int#) (a8 Int#) (d1 Double#) (d2 Double#) (d3 Double#) (d4 Double#) (d5 Double#) (d6 Double#) (d7 Double#) (d8 Double#) (d9 Double#) (d10 Double#))
    (prim fadd (prim fmul (prim int_to_double (prim add (prim mul (prim add (prim mul (prim add (prim mul (prim add (prim mul (prim add (prim mul (prim add (prim mul (prim add (prim mul a1 10) a2) 10) a3) 10) a4) 10) a5) 10) a6) 10) a7) 10) a8)) 1000.0) (prim fadd (prim fadd (prim fadd (prim fadd (prim fadd (prim fadd (prim fadd (prim fadd (prim fadd d1 (prim fmul d2 2.0)) (prim fmul d3 3.0)) (prim fmul d4 4.0)) (prim fmul d5 5.0)) (prim fmul d6 6.0)) (prim fmul d7 7.0)) (prim fmul d8 8.0)) (prim fmul d9 9.0)) (prim fmul d10 10.0)))))
; Prints its arguments and returns 200 + k (an i8 for C).
(def h_narrow (-> Env Int# Int# Int# Int#)
  (lam ((e Env) (a Int#) (b Int#) (c Int#))
    (let! (u1 Unit# (pi a))
    (let! (u2 Unit# (pi b))
    (let! (u3 Unit# (pi c))
      (prim add 200 (k e)))))))
; C calling the callback g, plus k.
(def h_outer (-> Env Int# Int# Int#)
  (lam ((e Env) (g Int#) (n Int#)) (prim add (extern cb_each g n) (k e))))
; Compares the i64 at pa and pb, in the direction k.
(def h_cmp (-> Env Int# Int# Int#)
  (lam ((e Env) (pa Int#) (pb Int#))
    (let! (a Int# (r pa 0))
    (let! (b Int# (r pb 0))
      (prim mul (k e) (prim sub (prim gt a b) (prim lt a b)))))))

; Makes, calls and frees a callback n times: the sum of 1..n.
(def churn (-> Int# Int# Int#)
  (lam ((n Int#) (acc Int#))
    (case n (z Int#) Int#
      (0 acc)
      (_ (let! (f Int# (extern times (con Env () n)))
         (let! (x Int# (extern cb_each f 1))
         (let! (u Unit# (extern cirka_callback_free f))
           (churn (prim sub n 1) (prim add acc x)))))))))

; Prints the 8 i64 at p.
(def show8 (-> Int# Unit#)
  (lam ((p Int#))
    (let! (s0 Unit# (extern cirka_write_i64 (r p 0)))
    (let! (s1 Unit# (extern cirka_write_char 32))
    (let! (s2 Unit# (extern cirka_write_i64 (r p 8)))
    (let! (s3 Unit# (extern cirka_write_char 32))
    (let! (s4 Unit# (extern cirka_write_i64 (r p 16)))
    (let! (s5 Unit# (extern cirka_write_char 32))
    (let! (s6 Unit# (extern cirka_write_i64 (r p 24)))
    (let! (s7 Unit# (extern cirka_write_char 32))
    (let! (s8 Unit# (extern cirka_write_i64 (r p 32)))
    (let! (s9 Unit# (extern cirka_write_char 32))
    (let! (s10 Unit# (extern cirka_write_i64 (r p 40)))
    (let! (s11 Unit# (extern cirka_write_char 32))
    (let! (s12 Unit# (extern cirka_write_i64 (r p 48)))
    (let! (s13 Unit# (extern cirka_write_char 32))
    (let! (s14 Unit# (extern cirka_write_i64 (r p 56)))
    (extern cirka_write_char 10))))))))))))))))))

(def main Int#
  (let! (t3 Int# (extern times (con Env () 3)))
  (let! (arr Int# (extern malloc 64))
  (let! (up Int# (extern cmp_cb (con Env () 1)))
  (let! (down Int# (extern cmp_cb (con Env () -1)))
  (let! (s0 Unit# (pi (extern cb_each t3 4)))
  (let! (s1 Unit# (let! (f Int# (extern big_cb (con Env () 2))) (let! (x Int# (extern cb_big f)) (let! (u Unit# (extern cirka_callback_free f)) (pi x)))))
  (let! (s2 Unit# (let! (f Int# (extern vec3_cb (con Env () 1))) (let! (x Double# (extern cb_vec3 f)) (let! (u Unit# (extern cirka_callback_free f)) (pf x)))))
  (let! (s3 Unit# (let! (f Int# (extern many_cb (con Env () 0))) (let! (x Double# (extern cb_many f)) (let! (u Unit# (extern cirka_callback_free f)) (pf x)))))
  (let! (s4 Unit# (let! (f Int# (extern narrow_cb (con Env () 0))) (let! (x Int# (extern cb_narrow f)) (let! (u Unit# (extern cirka_callback_free f)) (pi x)))))
  (let! (s5 Unit# (let! (f Int# (extern outer_cb (con Env () 100))) (let! (x Int# (extern cb_nested f t3)) (let! (u Unit# (extern cirka_callback_free f)) (pi x)))))
  (let! (s6 Unit# (w arr 0 5))
  (let! (s7 Unit# (w arr 8 -1))
  (let! (s8 Unit# (w arr 16 9))
  (let! (s9 Unit# (w arr 24 3))
  (let! (s10 Unit# (w arr 32 3))
  (let! (s11 Unit# (w arr 40 0))
  (let! (s12 Unit# (w arr 48 7))
  (let! (s13 Unit# (w arr 56 -4))
  (let! (s14 Unit# (extern qsort arr 8 8 up))
  (let! (s15 Unit# (show8 arr))
  (let! (s16 Unit# (extern qsort arr 8 8 down))
  (let! (s17 Unit# (show8 arr))
  (let! (s18 Unit# (pi (churn 10000 0)))
  (let! (s19 Unit# (extern cirka_callback_free up))
  (let! (s20 Unit# (extern cirka_callback_free down))
  (let! (s21 Unit# (extern cirka_callback_free t3))
  (let! (s22 Unit# (extern free arr))
  0))))))))))))))))))))))))))))
