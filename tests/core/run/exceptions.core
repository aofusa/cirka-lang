; Exceptions (FEAT-0040, 06-ir.md §1.8): `catch` applies an action to the
; state token and, when the action raises, the handler to the exception and
; the token. `finally` (made with `catch`) runs its release on both paths
; and raises the exception again. The frames an exception leaves release
; what they hold (the rest of the list in `total`): nothing leaks.
(data Int () (I# Int#))
(data List (a) (Nil) (Cons a (List a)))
(extern cirka_write_i64 (Int#) Unit#)
(extern cirka_write_bytes (Bytes) Unit#)
(extern cirka_write_char (Int#) Unit#)

(def say (-> Int# Unit#)
  (lam ((n Int#))
    (let! (u Unit# (extern cirka_write_i64 n))
      (extern cirka_write_char 10))))

(def text (-> Bytes Unit#)
  (lam ((s Bytes))
    (let! (u Unit# (extern cirka_write_bytes s))
      (extern cirka_write_char 10))))

; check n = I# n, or raises I# n when n is negative.
(def check (-> Int# Int)
  (lam ((n Int#))
    (case (prim lt n 0) (s Int#) Int
      (0 (con I# () n))
      (_ (prim raise (Int) (cast (con I# () n) Any))))))

; The sum of `check` of the elements.
(def total (-> (List Int) Int# Int#)
  (lam ((xs (List Int)) (acc Int#))
    (case xs (s (List Int)) Int#
      ((Nil) acc)
      ((Cons y ys)
        (case y (t Int) Int#
          ((I# v)
            (case (check v) (c Int) Int#
              ((I# w) (total ys (prim add acc w))))))))))

; n, n-1, .., 1, with -bad for bad.
(def list (-> Int# Int# (List Int))
  (lam ((n Int#) (bad Int#))
    (case n (s Int#) (List Int)
      (0 (con Nil (Int)))
      (_ (let ((x Int (case (prim eq n bad) (t Int#) Int
                        (0 (con I# () n))
                        (_ (con I# () (prim neg n))))))
           (con Cons (Int) x (list (prim sub n 1) bad)))))))

(def div (-> Int# Int# Int)
  (lam ((a Int#) (b Int#)) (con I# () (prim quot a b))))

; Runs the action: its number, or 1 and the number it raised.
(def show (-> (-> Unit# Int) Unit# Unit#)
  (lam ((act (-> Unit# Int)) (w Unit#))
    (let! (r Int
            (prim catch (Int) act
              (lam ((e Any) (w2 Unit#))
                (let! (u Unit# (say 1))
                  (cast e Int)))
              w))
      (case r (s Int) Unit#
        ((I# v) (say v))))))

; Runs the action: its number, or the message of the runtime error it
; raised and 0.
(def show_msg (-> (-> Unit# Int) Unit# Unit#)
  (lam ((act (-> Unit# Int)) (w Unit#))
    (let! (r Int
            (prim catch (Int) act
              (lam ((e Any) (w2 Unit#))
                (let! (u Unit# (text (cast e Bytes)))
                  (con I# () 0)))
              w))
      (case r (s Int) Unit#
        ((I# v) (say v))))))

; act, then fin; when act raises: fin, and the exception again.
(def finally (-> (-> Unit# Int) (-> Unit# Unit#) Unit# Int)
  (lam ((act (-> Unit# Int)) (fin (-> Unit# Unit#)) (w Unit#))
    (let! (r Int
            (prim catch (Int) act
              (lam ((e Any) (w2 Unit#))
                (let! (u Unit# (fin w2))
                  (prim raise (Int) e)))
              w))
      (let! (u Unit# (fin w)) r))))

(def main Int#
  ; 15
  (let! (a Unit# (show (lam ((w Unit#)) (con I# () (total (list 5 0) 0))) unit))
  ; 1 -3: `check` raises while `total` holds the rest of the list.
  (let! (b Unit# (show (lam ((w Unit#)) (con I# () (total (list 5 3) 0))) unit))
  ; A runtime error and a panic are caught as their messages.
  (let! (c Unit# (show_msg (lam ((w Unit#)) (div 7 (prim sub 3 3))) unit))
  (let! (d Unit# (show_msg (lam ((w Unit#)) (panic "boom" Int)) unit))
  ; The release runs (99), then the outer `catch` gets the exception.
  (let! (e Unit#
          (show (lam ((w Unit#))
                  (finally (lam ((w1 Unit#)) (check (prim neg 7)))
                           (lam ((w3 Unit#)) (say 99)) w)) unit))
  ; Without an exception: the release (99), then the number.
  (let! (f Unit#
          (show (lam ((w Unit#))
                  (finally (lam ((w1 Unit#)) (check 5))
                           (lam ((w3 Unit#)) (say 99)) w)) unit))
  ; A thunk that raised raises the same exception when forced again.
  (let ((t Int (check (prim neg 4))))
    (let! (g Unit#
            (show (lam ((w Unit#))
                    (case t (s Int) Int ((I# v) (con I# () (prim add v 1))))) unit))
    (let! (h Unit# (show (lam ((w Unit#)) t) unit))
      0))))))))))
