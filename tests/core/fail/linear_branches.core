; a linear variable consumed in one branch only
(data Handle () :linear (MkHandle Int#))
(data Int () (I# Int#))
(def close (-> 1 Handle Int#) (lam ((h 1 Handle)) (case h (s 1 Handle) Int# ((MkHandle fd) fd))))
(def bad (-> Int# (-> 1 Handle Int#)) (lam ((k Int#) (h 1 Handle))
  (case k (s Int#) Int# (0 (close h)) (_ 1))))
(def main Int# 0)
