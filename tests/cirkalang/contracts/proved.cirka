module Main

-- Checks removed by proofs (spec-v0.0.4.md §5): bounds, division by zero,
-- a branch proved unreachable.

import Data.Array as A

search : (arr : A.Array Int) -> (key : Int) -> (lo : Int) -> (hi : Int) -> Int
  requires 0 <= lo && hi <= A.size arr
search arr key lo hi =
  if lo >= hi then -1
  else
    let mid = lo + (hi - lo) / 2
        x = A.index arr mid
    in if x == key then mid
       else if x < key then search arr key (mid + 1) hi
       else search arr key lo mid

avg : Int -> Int -> Int
avg s n = if n == 0 then 0 else divNZ s n

sign : Int -> Int
sign x = if x > 0 then 1 else if x < 0 then -1 else if x == 0 then 0 else unreachable ()

main : IO ()
main = do
  let arr = A.fromList [1, 3, 5, 7, 9]
  printInt (search arr 7 0 (A.size arr))
  printInt (avg 10 3)
  printInt (sign (-7))
