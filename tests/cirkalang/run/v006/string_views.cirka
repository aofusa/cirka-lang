-- requires: z3
-- Views of strings read at indices proved in bounds (spec-v0.0.6.md §5,
-- FEAT-0254): `S.index` reads a byte without a bounds check where the
-- index is proved below `S.length`, which is not negative (the invariant
-- of `Str`), and the proofs know the lengths of the views made by
-- `take`, `drop` and `slice`.
module Main

import Data.String as S
import Data.String (Str, toStr)

-- The sum of the bytes from `k`.
sumBytes : (v : Str) -> (k : Int) -> Int -> Int
  requires 0 <= k
sumBytes v k acc = if k >= S.length v then acc else sumBytes v (k + 1) (acc + S.index v k)

-- The same bytes from both ends.
palindrome : (v : Str) -> (lo : Int) -> (hi : Int) -> Bool
  requires 0 <= lo && hi < S.length v
palindrome v lo hi =
  if lo >= hi then True
  else if S.index v lo == S.index v hi then palindrome v (lo + 1) (hi - 1)
  else False

isPalindrome : Str -> Bool
isPalindrome v = palindrome v 0 (S.length v - 1)

digit : Int -> Int
digit b = b - 48

-- The year of a date "yyyy-mm-dd": its first four bytes.
year : Str -> Maybe Int
year v =
  if S.length v < 4 then Nothing
  else
    let y = S.take 4 v in
    Just (digit (S.index y 0) * 1000 + digit (S.index y 1) * 100 + digit (S.index y 2) * 10 + digit (S.index y 3))

-- The day: bytes 8 and 9.
day : Str -> Maybe Int
day v =
  if S.length v < 10 then Nothing
  else
    let d = S.slice v 8 10 in
    Just (digit (S.index d 0) * 10 + digit (S.index d 1))

-- The byte `k` after the first `n`.
afterPrefix : (n : Int) -> (k : Int) -> (v : Str) -> Int
  requires 0 <= n && 0 <= k && k < S.length v - n
afterPrefix n k v = S.index (S.drop n v) k

main : IO ()
main = do
  let text = toStr "racecar level 2026-11-17 noon"
  printInt (sumBytes text 0 0)
  print (map isPalindrome (S.words text))
  let date = S.slice text 14 24
  print (S.fromStr date, year date, day date)
  print (year (S.take 3 date), day (S.drop 1 date))
  let w = S.drop 8 text
  print (S.fromStr w, if 3 < S.length w - 2 then afterPrefix 2 3 w else 0)
  print (S.byteAt text 2, S.length (S.slice text 26 100), S.length (S.take (negate 1) text))
