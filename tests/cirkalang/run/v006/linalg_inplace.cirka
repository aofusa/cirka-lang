-- requires: lib:openblas lib:lapacke
-- max-array-copies: 0
-- BLAS and LAPACK work on the arrays of the matrices where they are
-- (spec-v0.0.6.md §4.2, FEAT-0257): BLAS reads its inputs without copies
-- and writes a new array or that of `c`, and LAPACK overwrites the arrays
-- of its inputs, which are not copied when nothing else shares them, as
-- here (`linalg.cirka` has shared ones).
import Linalg

-- Upper triangular with 1, 2, 3 on the diagonal: LAPACK swaps no rows.
tri : Int -> Matrix 3 3
tri k = matrix 3 3 (\i, j => if i == j then toFloat (i + 1) else if j == i + 1 then toFloat (k + i) else 0.0)

cols : Int -> Matrix 3 2
cols k = matrix 3 2 (\i, j => toFloat (k * i - j))

r9 : Float -> Float
r9 x = toFloat (truncate (x * 1000000000.0 + (if x < 0.0 then 0.0 - 0.5 else 0.5))) / 1000000000.0

rounded : Matrix m n -> List (List Float)
rounded a = map (map r9) (toLists a)

main : IO ()
main = do
  print (mul (tri 2) (cols 1))
  -- `c` is new: the result is written into its array.
  print (gemm 2.0 (tri 2) (cols 1) 1.0 (cols 5))
  print (fmap rounded (solve (tri 3) (cols 2)))
  print (fmap rounded (inverse (tri 4)))
  print (det (tri 5), det (transpose (tri 6)))
