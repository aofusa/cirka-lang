module Main

data Color = Red | Green | Blue deriving (Eq, Ord, Show)

data Tree a = Leaf | Node (Tree a) a (Tree a) deriving (Eq, Show)

data Version = MkVersion Int Int deriving (Eq, Ord, Show)

data Wrap = MkWrap (Maybe Int) deriving (Eq, Show)

insert : Ord a => a -> Tree a -> Tree a
insert x Leaf = Node Leaf x Leaf
insert x (Node l v r) =
  if x < v then Node (insert x l) v r
  else if x > v then Node l v (insert x r)
  else Node l v r

main : IO ()
main = do
  putStrLn (show Green)
  putStrLn (show (Red == Red && Red /= Blue))
  putStrLn (show (compare Red Blue))
  putStrLn (show (max Green Blue))
  putStrLn (show (insert 1 (insert 2 Leaf)))
  putStrLn (show (insert 1 (insert 2 Leaf) == insert 1 (insert 2 Leaf)))
  putStrLn (show (MkVersion 1 2 < MkVersion 1 3))
  putStrLn (show (MkVersion 2 0 <= MkVersion 1 9))
  putStrLn (show (MkWrap (Just (negate 1))))
