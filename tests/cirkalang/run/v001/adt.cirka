module Main

data Tree a = Leaf | Node (Tree a) a (Tree a)

insert : Int -> Tree Int -> Tree Int
insert x Leaf = Node Leaf x Leaf
insert x (Node l v r) =
  if x < v then Node (insert x l) v r
  else if x > v then Node l v (insert x r)
  else Node l v r

toList : Tree a -> List a
toList Leaf = Nil
toList (Node l v r) = append (toList l) (v :: toList r)

depth : Tree a -> Int
depth Leaf = 0
depth (Node l _ r) = 1 + max (depth l) (depth r)

data Shape = Circle Int | Rect Int Int | Tri Int Int Int

area : Shape -> Int
area (Circle r) = 3 * r * r
area (Rect w h) = w * h
area (Tri a b c) = a + b + c

safeDiv : Int -> Int -> Maybe Int
safeDiv _ 0 = Nothing
safeDiv a b = Just (a / b)

describe : Either Int Bool -> Int
describe (Left n) = n
describe (Right True) = 1
describe (Right False) = 0

zipSum : List Int -> List Int -> List Int
zipSum (x :: xs) (y :: ys) = x + y :: zipSum xs ys
zipSum _ _ = Nil

main : IO ()
main = do
  let t = foldl (\acc, x => insert x acc) Leaf [5, 3, 8, 1, 4, 7, 9, 2, 6]
  mapM_ printInt (toList t)
  printInt (depth t)
  printInt (sum (map area [Circle 2, Rect 3 4, Tri 1 2 3]))
  printInt (fromMaybe (-1) (safeDiv 10 2))
  printInt (fromMaybe (-1) (safeDiv 10 0))
  printInt (describe (Left 7) + describe (Right True))
  printInt (sum (zipSum [1, 2, 3] [10, 20]))
  printInt (fst (snd (1, (2, 3))))
