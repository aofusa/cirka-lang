module Main

-- Branches on comparisons of integers and floats (FEAT-0074).

classify : Int -> Int
classify n = if n < 3 then 1 else if n >= 10 then 2 else 3

above : Float -> Float -> Int
above a b = if a >. b then 1 else 0

count : Int -> Int -> Int
count i acc = if i >= 5 then acc else count (i + 1) (if classify i == 1 then acc + 1 else acc)

main : IO ()
main = do
  putStrLn (showInt (classify 1))
  putStrLn (showInt (classify 3))
  putStrLn (showInt (classify 12))
  putStrLn (showInt (above 2.5 1.5))
  putStrLn (showInt (above 1.5 2.5))
  putStrLn (showInt (count 0 0))
