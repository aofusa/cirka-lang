module Main

-- Contracts proved by Z3 (spec-v0.0.4.md §4): binary search, a data type
-- with an invariant, requires / ensures.

import Data.Array as A

-- Binary search in a sorted array: the index found is in bounds and holds
-- the key.
found : A.Array Int -> Int -> Maybe Int -> Bool
found arr key r = case r of
  Just i => 0 <= i && i < A.size arr && A.index arr i == key
  Nothing => True

search : (arr : A.Array Int) -> (key : Int) -> (lo : Int) -> (hi : Int) -> Maybe Int
  requires 0 <= lo && hi <= A.size arr
  ensures found arr key
search arr key lo hi =
  if lo >= hi then Nothing
  else
    let mid = lo + (hi - lo) / 2
        x = A.index arr mid
    in if x == key then Just mid
       else if x < key then search arr key (mid + 1) hi
       else search arr key lo mid

binarySearch : (arr : A.Array Int) -> (key : Int) -> Maybe Int
  ensures found arr key
binarySearch arr key = search arr key 0 (A.size arr)

-- A data type with an invariant. (`hi - lo` wraps when `lo` is very
-- negative, BUG-0018: the range starts at 0 or above.)
data Range : Type where
  MkRange : (lo : Int) -> (hi : Int) -> Range
  invariant 0 <= lo && lo <= hi

total
width : Range -> Int
  ensures \w => w >= 0
width (MkRange lo hi) = hi - lo

total
range : Int -> Int -> Range
range a b = if a < 0 || b < 0 then MkRange 0 0 else if a <= b then MkRange a b else MkRange b a

total
clamp : (lo : Int) -> (hi : Int) -> (x : Int) -> Int
  requires lo <= hi
  ensures \r => lo <= r && r <= hi
clamp lo hi x = if x < lo then lo else if x > hi then hi else x

showMaybe : Maybe Int -> String
showMaybe (Just i) = "Just " ++ show i
showMaybe Nothing = "Nothing"

main : IO ()
main = do
  let arr = A.fromList [1, 3, 5, 7, 9, 11]
  putStrLn (showMaybe (binarySearch arr 7))
  putStrLn (showMaybe (binarySearch arr 4))
  printInt (width (range 9 2))
  printInt (clamp 0 10 42)
