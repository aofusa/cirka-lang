-- A type parameter in `Type` cannot be instantiated with a linear type
-- (BUG-0015).

data Tok : LType where
  MkTok : Int -> Tok

dup : {a : Type} -> a -> Pair a a
dup x = MkPair x x

mk : Int -> Tok
mk n = MkTok n

use : (1 t : Tok) -> Int
use t = case t of
  MkTok n => n

main : IO ()
main = case dup (mk 3) of
  MkPair a b => printInt (use a + use b)
