(module Main)
(total sig (len) (-> (List a) Int))
(def len ([]) 0)
(def len ((ops _ :: xs)) (ops 1 + (len xs)))
(partial sig (hd) (-> (List a) a))
(def hd ((ops x :: _)) x)
(covering sig (gcd) (-> Int (-> Int Int)))
(def gcd (a 0) a)
(def gcd (a b) (gcd b (ops a % b)) (decreasing (abs b)))
(trusted total sig (sized) (-> (n : Int) (subset result$ (List Int) ((\ (r) (ops (len r) == n)) result$))))
(def sized (n) [])
(private trusted total sig (sized2) (-> Int Int))
(def sized2 (n) n)
(private trusted sig (sized3) (-> Int Int))
(def sized3 (n) n)
