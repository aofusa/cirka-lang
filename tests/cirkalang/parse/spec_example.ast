(module Main)
(data Tree
  (Leaf )
  (Node Tree Tree))
(sig (make) (-> Int Tree))
(def make (0) (Node Leaf Leaf))
(def make (d) (Node (make (ops d - 1)) (make (ops d - 1))))
(sig (check) (-> Tree Int))
(def check (Leaf) 0)
(def check ((Node l r)) (ops 1 + (check l) + (check r)))
(sig (append) (-> (Vect n a) (-> (Vect m a) (Vect (ops n + m) a))))
(def append (VNil ys) ys)
(def append ((VCons x xs) ys) (VCons x (append xs ys)))
(sig (swap) (-> (1 p : (tuple a b)) (tuple b a)))
(def swap ((tuple x y)) (tuple y x))
(sig (main) (IO ()))
(def main () (do (printInt (check (make 10))) (let (v = (append (VCons 1 VNil) (VCons 2 (VCons 3 VNil))))) (printInt (vlength v))))
