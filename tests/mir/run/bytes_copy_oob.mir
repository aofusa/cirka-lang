extern fn cirka_write_bytes(ptr) -> void
extern fn cirka_bytes_copy(ptr, i64, ptr, i64, i64) -> i64

// A copy past the end of its destination panics, as the runtime function
// does (FEAT-0097: the inline copy keeps its bounds check). The
// destination is held by a global, which the leak check counts as live.
global buf = mk_buf

fn mk_buf() -> ptr {
entry:
  let b = prim bytes_new(4)
  ret b
}

fn main() -> i64 {
entry:
  let g = global buf
  let t = force g
  let _ = extern cirka_bytes_copy(t, 1, "abc", 0, 3)
  let _ = extern cirka_write_bytes("before\n")
  let _ = extern cirka_bytes_copy(t, 2, "abc", 0, 3)
  let _ = extern cirka_write_bytes("after\n")
  drop t
  ret 0
}
