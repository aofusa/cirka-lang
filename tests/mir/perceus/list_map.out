type List { Nil = 0 {}, Cons = 1 { head: ptr, tail: ptr } }
type Int { I = 0 { v: i64 } }
extern fn cirka_write_i64(i64) -> void
extern fn cirka_write_char(i64) -> void

fn range(i: i64, n: i64) -> ptr {
entry:
  let c = prim gt(i, n)
  switch c { 1 => done, default => more }
done:
  let nil = alloc List.Nil()
  ret nil
more:
  let i1 = prim add(i, 1)
  let rest = call range(i1, n)
  let b = alloc Int.I(i)
  let r = alloc List.Cons(b, rest)
  ret r
}

fn double_all(xs: ptr @owned) -> ptr {
entry:
  switch xs { List.Nil => nil, List.Cons => cons }
nil:
  ret xs
cons:
  let h = proj xs List.Cons.head
  let t = proj xs List.Cons.tail
  let v = proj h Int.I.v
  let v2 = prim add(v, v)
  let b = alloc Int.I(v2)
  dup t
  let t2 = call double_all(t)
  drop xs
  let r = alloc List.Cons(b, t2)
  ret r
}

fn sum(xs: ptr @borrowed, acc: i64) -> i64 {
entry:
  switch xs { List.Nil => nil, List.Cons => cons }
nil:
  ret acc
cons:
  let t = proj xs List.Cons.tail
  let h = proj xs List.Cons.head
  let v = proj h Int.I.v
  let acc2 = prim add(acc, v)
  tailcall sum(t, acc2)
}

fn main() -> i64 {
entry:
  let xs = call range(1, 100)
  dup xs
  let ys = call double_all(xs)
  let a = call sum(xs, 0)
  drop xs
  let b = call sum(ys, 0)
  drop ys
  let unused = call range(1, 3)
  drop unused
  let _ = extern cirka_write_i64(a)
  let _ = extern cirka_write_char(32)
  let _ = extern cirka_write_i64(b)
  let _ = extern cirka_write_char(10)
  ret 0
}
