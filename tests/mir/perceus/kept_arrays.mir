// Arrays that loops get back from the functions they call (FEAT-0076): the
// loops assume unique arrays across the calls, and go on after a first
// iteration in the old body when the array was shared.
extern fn cirka_write_i64(i64) -> void
extern fn cirka_write_char(i64) -> void

fn mk() -> ptr {
entry:
  let a = prim bytes_new(32)
  let c = prim bytes_unique(a)
  let w = prim bytes_set_i64(c, 0, 2)
  let v = prim bytes_set_i64(c, 1, 1)
  let u = prim bytes_set_i64(c, 2, 3)
  ret c
}

fn flips(p: ptr, f: i64) -> (ptr, i64) {
entry:
  let k = prim bytes_get_i64(p, 0)
  switch k { 0 => done, default => more }
done:
  ret (p, f)
more:
  let r = call rev(p, 0, k)
  let g = prim add(f, 1)
  tailcall flips(r, g)
}

fn rev(a: ptr, lo: i64, hi: i64) -> ptr {
entry:
  let d = prim ge(lo, hi)
  switch d { 0 => body, default => done }
done:
  ret a
body:
  let c = prim bytes_unique(a)
  let x = prim bytes_get_i64(c, lo)
  let y = prim bytes_get_i64(c, hi)
  let w = prim bytes_set_i64(c, lo, y)
  let v = prim bytes_set_i64(c, hi, x)
  let l = prim add(lo, 1)
  let h = prim sub(hi, 1)
  tailcall rev(c, l, h)
}

fn show(a: ptr, i: i64) -> i64 {
entry:
  let d = prim ge(i, 4)
  switch d { 0 => body, default => done }
done:
  ret 0
body:
  let x = prim bytes_get_i64(a, i)
  let _ = extern cirka_write_i64(x)
  let j = prim add(i, 1)
  tailcall show(a, j)
}

fn main() -> i64 {
entry:
  let t = call mk()
  let (r, n) = call flips(t, 0)
  let _ = call show(r, 0)
  let _ = extern cirka_write_char(32)
  let _ = extern cirka_write_i64(n)
  let _ = extern cirka_write_char(10)
  let s = call mk()
  let (q, m) = call flips(s, 0)
  let _ = call show(q, 0)
  let o = call show(s, 0)
  let _ = extern cirka_write_char(32)
  let _ = extern cirka_write_i64(m)
  let _ = extern cirka_write_i64(o)
  let _ = extern cirka_write_char(10)
  ret 0
}
