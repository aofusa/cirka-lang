(def Main.name (-> Main.Color (List Char))
  (lam ((a Main.Color))
    (case a (s Main.Color) (List Char)
      ((Main.Red) (prim$unpack "red"))
      ((Main.Green) (prim$unpack "green"))
      ((Main.Blue) (prim$unpack "blue")))))

(def Main.zipW (forall (a b c) (-> (-> a b c) (List a) (List b) (List c)))
  (tlam (a b c)
    (lam ((a~447 (-> a b c)) (a~448 (List a)) (a~449 (List b)))
      (case a~448 (s~465 (List a)) (List c)
        ((Cons f~453 f~454) (case a~449 (s~464 (List b)) (List c)
            ((Cons f~458 f~459) (con Cons (c) (a~447 f~453 f~458) ((@ Main.zipW a b c) a~447 f~454 f~459)))
            (_ (con Nil (c)))))
        (_ (con Nil (c)))))))

(def Main.digit (-> Int Char)
  (lam ((a Int))
    (case a (s Int) Char
      ((I# u) (case u (k Int#) Char
          (0 (con C# () 48))
          (1 (con C# () 49))
          (_ (con C# () 63)))))))

(def Main.clamp (-> Int Int)
  (lam ((a Int))
    (case (Prelude.== a (con I# () 0)) (g Bool) Int
      ((True) (con I# () 0))
      (_ (Prelude.+ a (con I# () 1))))))

(def Main.main (IO Unit)
  (Cirka.Prim.putStr (Main.name (con Main.Red ()))))
