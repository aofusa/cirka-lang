8 | foreign import ccall "h1" h2 :: Double -> Int
  | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
error[E0618]: calling convention `stdcall` is not supported
 --> tests/achc/desugar/ffi_errors.hs:9:1
