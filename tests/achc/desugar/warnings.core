(def Main.isRed (-> Main.Color Bool)
  (lam ((a Main.Color))
    (case a (s Main.Color) Bool
      ((Main.Red) (con True ()))
      ((Main.Green) (con False ()))
      (_ (panic "non-exhaustive patterns" Bool)))))

(def Main.first (forall (a) (-> (List a) a))
  (tlam (a)
    (lam ((a (List a)))
      (case a (s (List a)) a
        ((Cons f~443 f~444) f~443)
        (_ (panic "non-exhaustive patterns" a))))))

(def Main.dup (-> Bool Int)
  (lam ((a Bool))
    (con I# () 1)))

(def Main.main (IO Unit)
  ((@ Prelude.return Unit) (con Unit ())))
