(module Layout
  (fun f (x)
    (let ((fun y () (ops x `+` 1) ) (fun z () (ops y `*` 2) )) (ops y `+` z))
  )
  (fun g (x)
    (case x (0 -> "zero") (n -> (| ((ops n `<` 0)) "negative") (| (otherwise) "positive")))
  )
  (fun h ()
    (let ((fun a () 1 ) (fun b () 2 )) (ops a `+` b))
  )
  (fun k ()
    (listcomp (tuple i j) (<- i (range 1 _ 3)) (let (fun j () (ops i `*` i) )) (odd j))
  )
  (sig (main) (IO ()))
  (fun main ()
    (do (let (fun xs () ((map f) [1 2 3]) )) (if (null xs) (return ()) ((mapM_ print) xs)) (putStrLn (paren (g 1))))
    (where
      (fun unused ()
        ()
      )
    )
  )
  (fun tricky ()
    (ops (paren (case 1 (1 -> 2))) `+` (paren (let ((fun x () 3 )) x)))
  )
)
