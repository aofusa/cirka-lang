(module Main
  (exports main)
  (import Data.List (sortBy foldl'))
  (import Data.Map qualified as M)
  (infixl 6 |+|)
  (data Vec ()
    (con Vec (record (vx !Double) (vy !Double)))
    (deriving Eq Show)
  )
  (sig (|+|) (-> Vec (-> Vec Vec)))
  (fun |+| ((Vec a b) (Vec c d))
    ((Vec (paren (ops a `+` c))) (paren (ops b `+` d)))
  )
  (data Tree (a)
    (con Leaf )
    (con Node (Tree a) a (Tree a))
  )
  (sig (insert) (=> ((Ord a)) (-> a (-> (Tree a) (Tree a)))))
  (fun insert (x Leaf)
    (((Node Leaf) x) Leaf)
  )
  (fun insert (x t@(Node l y r))
    (| ((ops x `<` y)) (((Node (paren ((insert x) l))) y) r))
    (| ((ops x `>` y)) (((Node l) y) (paren ((insert x) r))))
    (| (otherwise) t)
  )
  (sig (toList) (-> (Tree a) [a]))
  (fun toList (Leaf)
    []
  )
  (fun toList ((Node l x r))
    (ops (toList l) `++` [x] `++` (toList r))
  )
  (sig (primes) [Int])
  (fun primes ()
    (sieve (range 2 _ _))
    (where
      (fun sieve ((ops p `:` xs))
        (ops p `:` (sieve (listcomp x (<- x xs) (ops x `mod` p `/=` 0))))
      )
    )
  )
  (sig (queens) (-> Int [[Int]]))
  (fun queens (n)
    (go n)
    (where
      (fun go (0)
        [[]]
      )
      (fun go (k)
        (listcomp (ops q `:` qs) (<- qs (go (paren (ops k `-` 1)))) (<- q (range 1 _ n)) ((safe q) qs))
      )
      (fun safe (q qs)
        (and (listcomp (ops q `/=` c `&&` (abs (paren (ops q `-` c))) `/=` d) (<- (tuple d c) ((zip (range 1 _ _)) qs))))
      )
    )
  )
  (class () Shape (a)
    (sig (area) (-> a Double))
    (sig (name) (-> a String))
    (fun name (_)
      "shape"
    )
  )
  (instance () Shape Vec
    (fun area ((Vec x y))
      (ops x `*` y)
    )
  )
  (sig (main) (IO ()))
  (fun main ()
    (do (print (paren ((take 10) primes))) (print (paren (length (paren (queens 6))))) (let (fun t () (((foldr insert) Leaf) [5 3 8 (:: 1 Int)]) )) ((mapM_ (paren (ops putStrLn `.` show))) (paren (toList t))) (ops print `$` (area (paren (ops ((Vec 2) 3) `|+|` ((Vec 1) 1))))) (print (tuple (negate 3) (ops neg 4) ((paren (subtract 1)) 5) ((section `div` 2) 9) ((section 2 `^`) 10))))
  )
)
