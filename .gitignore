# Rust build output
/target/
**/*.rs.bk

# Build output of achc / cirka (compiled programs, LLVM IR, objects), in
# whichever directory the compiler ran (the integration tests run with
# tests/ as the working directory)
_build/
*.ll.tmp
*.o

# Environment-specific settings (copy .env.sample to .env)
.env

# Temporary artifacts produced by AI agents
docs/artifacts/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
