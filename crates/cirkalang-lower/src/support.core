; Support functions for the primitives of CirkaLang v0.0.1 (spec-v0.0.1.md
; §5.4). Merged into every lowered program; unused ones are removed by DCE.

(extern cirka_write_i64 (Int#) Unit#)
(extern cirka_write_f64 (Double#) Unit#)
(extern cirka_write_char (Int#) Unit#)
(extern cirka_write_bytes (Bytes) Unit#)
(extern cirka_panic_bytes (Bytes) Unit#)
(extern cirka_exit (Int#) Unit#)
(extern cirka_read_byte () Int#)
(extern cirka_argc () Int#)
(extern cirka_arg (Int#) Bytes)
(extern cirka_f64_to_bytes (Double#) Bytes)
(extern sqrt (Double#) Double#)
(extern trunc (Double#) Double#)
; Regions (spec-v0.0.3.md §3).
(extern cirka_region_new () Any)
(extern cirka_region_free (Any) Int#)
(extern cirka_region_cell (Any Any) Int#)
(extern cirka_region_get (Int#) Any)
(extern cirka_region_set (Int# Any) Int#)

; Unsigned comparison through the sign bit.
(def cirka$ult (-> Int# Int# Int#)
  (lam ((a Int#) (b Int#))
    (prim lt (prim xor a -9223372036854775808) (prim xor b -9223372036854775808))))

(def cirka$ule (-> Int# Int# Int#)
  (lam ((a Int#) (b Int#))
    (prim le (prim xor a -9223372036854775808) (prim xor b -9223372036854775808))))

; ---- strings (Bytes) ----

(def cirka$bytes_eq_loop (-> Bytes Bytes Int# Int# Int#)
  (lam ((a Bytes) (b Bytes) (i Int#) (n Int#))
    (case (prim lt i n) (c Int#) Int#
      (0 1)
       (_ (case (prim eq (prim bytes_get a i) (prim bytes_get b i)) (d Int#) Int#
            (0 0)
             (_ (cirka$bytes_eq_loop a b (prim add i 1) n)))))))

(def cirka$bytes_eq (-> Bytes Bytes Int#)
  (lam ((a Bytes) (b Bytes))
    (let! (n Int# (prim bytes_len a))
      (case (prim eq n (prim bytes_len b)) (c Int#) Int#
        (0 0)
         (_ (cirka$bytes_eq_loop a b 0 n))))))

; Copies src[0..n] to dst[off..off+n] and returns dst. The buffer is
; threaded through the result so it stays unique for `bytes_set`.
(def cirka$bytes_copy (-> Bytes Bytes Int# Int# Int# Bytes)
  (lam ((dst Bytes) (src Bytes) (off Int#) (i Int#) (n Int#))
    (case (prim lt i n) (c Int#) Bytes
      (0 dst)
       (_ (let! (u Unit# (prim bytes_set dst (prim add off i) (prim bytes_get src i)))
            (cirka$bytes_copy dst src off (prim add i 1) n))))))

(def cirka$bytes_concat (-> Bytes Bytes Bytes)
  (lam ((a Bytes) (b Bytes))
    (let! (la Int# (prim bytes_len a))
      (let! (lb Int# (prim bytes_len b))
        (let! (r Bytes (prim bytes_new (prim add la lb)))
          (let! (r1 Bytes (cirka$bytes_copy r a 0 0 la))
            (cirka$bytes_copy r1 b la 0 lb)))))))

(def cirka$ndigits (-> Int# Int# Int#)
  (lam ((v Int#) (acc Int#))
    (case v (c Int#) Int#
      (0 acc)
       (_ (cirka$ndigits (prim quot v 10) (prim add acc 1))))))

(def cirka$fill_digits (-> Bytes Int# Int# Bytes)
  (lam ((r Bytes) (i Int#) (v Int#))
    (case v (c Int#) Bytes
      (0 r)
       (_ (let! (d Int# (prim rem v 10))
            (let! (d2 Int# (case (prim lt d 0) (e Int#) Int# (0 d) (_ (prim neg d))))
              (let! (u Unit# (prim bytes_set r i (prim add 48 d2)))
                (cirka$fill_digits r (prim sub i 1) (prim quot v 10)))))))))

(def cirka$int_to_bytes (-> Int# Bytes)
  (lam ((n Int#))
    (case n (c Int#) Bytes
      (0 "0")
       (_ (let! (neg Int# (prim lt n 0))
            (let! (len Int# (prim add (cirka$ndigits n 0) neg))
              (let! (r Bytes (cirka$fill_digits (prim bytes_new len) (prim sub len 1) n))
                (case neg (e Int#) Bytes
                  (0 r)
                   (_ (let! (u Unit# (prim bytes_set r 0 45)) r))))))))))

(def cirka$char_to_bytes (-> Int# Bytes)
  (lam ((c Int#))
    (case (prim lt c 128) (k1 Int#) Bytes
      (1 (let! (r Bytes (prim bytes_new 1))
            (let! (u Unit# (prim bytes_set r 0 c)) r)))
       (_ (case (prim lt c 2048) (k2 Int#) Bytes
            (1 (let! (r Bytes (prim bytes_new 2))
                  (let! (u Unit# (prim bytes_set r 0 (prim or 192 (prim shr c 6))))
                    (let! (u2 Unit# (prim bytes_set r 1 (prim or 128 (prim and c 63)))) r))))
             (_ (case (prim lt c 65536) (k3 Int#) Bytes
                  (1 (let! (r Bytes (prim bytes_new 3))
                        (let! (u Unit# (prim bytes_set r 0 (prim or 224 (prim shr c 12))))
                          (let! (u2 Unit# (prim bytes_set r 1 (prim or 128 (prim and (prim shr c 6) 63))))
                            (let! (u3 Unit# (prim bytes_set r 2 (prim or 128 (prim and c 63)))) r)))))
                   (_ (let! (r Bytes (prim bytes_new 4))
                        (let! (u Unit# (prim bytes_set r 0 (prim or 240 (prim shr c 18))))
                          (let! (u2 Unit# (prim bytes_set r 1 (prim or 128 (prim and (prim shr c 12) 63))))
                            (let! (u3 Unit# (prim bytes_set r 2 (prim or 128 (prim and (prim shr c 6) 63))))
                              (let! (u4 Unit# (prim bytes_set r 3 (prim or 128 (prim and c 63)))) r)))))))))))))

; ---- input ----

(def cirka$skip_ws (-> Int# Int#)
  (lam ((c Int#))
    (case c (k Int#) Int#
      (32 (cirka$skip_ws (extern cirka_read_byte)))
       (10 (cirka$skip_ws (extern cirka_read_byte)))
       (9 (cirka$skip_ws (extern cirka_read_byte)))
       (13 (cirka$skip_ws (extern cirka_read_byte)))
       (_ c))))

(def cirka$read_digits (-> Int# Int# Int#)
  (lam ((c Int#) (acc Int#))
    (case (prim le 48 c) (k Int#) Int#
      (0 acc)
       (_ (case (prim le c 57) (k2 Int#) Int#
            (0 acc)
             (_ (cirka$read_digits (extern cirka_read_byte)
                                   (prim add (prim mul acc 10) (prim sub c 48)))))))))

; Reads a decimal integer from stdin (0 at the end of input).
(def cirka$read_int (-> Unit# Int#)
  (lam ((w Unit#))
    (let! (c Int# (cirka$skip_ws (extern cirka_read_byte)))
      (case c (k Int#) Int#
        (45 (prim neg (cirka$read_digits (extern cirka_read_byte) 0)))
         (_ (cirka$read_digits c 0))))))

; ---- unboxed arrays (spec-v0.0.2.md §7.3) ----
; A fresh array of `n` zeroed 8-byte words (an empty one for `n <= 0`).
(def cirka$uarr_new (-> Int# Bytes)
  (lam ((n Int#))
    (prim bytes_new (prim mul (case (prim lt n 0) (c Int#) Int# (1 0) (_ n)) 8))))

; ---- byte-level string operations (spec-v0.0.2.md §7.4) ----

(def cirka$clamp (-> Int# Int# Int# Int#)
  (lam ((x Int#) (lo Int#) (hi Int#))
    (case (prim lt x lo) (c Int#) Int#
      (0 (case (prim lt hi x) (d Int#) Int# (0 x) (_ hi)))
       (_ lo))))

; Copies src[i..i+n] to dst[off..] and returns dst.
(def cirka$bytes_copy_at (-> Bytes Int# Bytes Int# Int# Bytes)
  (lam ((dst Bytes) (off Int#) (src Bytes) (i Int#) (n Int#))
    (case (prim lt 0 n) (c Int#) Bytes
      (0 dst)
       (_ (let! (u Unit# (prim bytes_set dst off (prim bytes_get src i)))
            (cirka$bytes_copy_at dst (prim add off 1) src (prim add i 1) (prim sub n 1)))))))

; A copy of s[i..j], with i and j clamped to the string.
(def cirka$bytes_slice (-> Bytes Int# Int# Bytes)
  (lam ((s Bytes) (i Int#) (j Int#))
    (let! (n Int# (prim bytes_len s))
      (let! (a Int# (cirka$clamp i 0 n))
        (let! (b Int# (cirka$clamp j a n))
          (cirka$bytes_copy_at (prim bytes_new (prim sub b a)) 0 s a (prim sub b a)))))))

(def cirka$bytes_find_byte_loop (-> Bytes Int# Int# Int# Int#)
  (lam ((s Bytes) (b Int#) (i Int#) (j Int#))
    (case (prim lt i j) (c Int#) Int#
      (0 -1)
       (_ (case (prim eq (prim bytes_get s i) b) (d Int#) Int#
            (0 (cirka$bytes_find_byte_loop s b (prim add i 1) j))
             (_ i))))))

; The first index in [i, j) (clamped) of byte b, or -1.
(def cirka$bytes_find_byte (-> Bytes Int# Int# Int# Int#)
  (lam ((s Bytes) (b Int#) (i Int#) (j Int#))
    (let! (n Int# (prim bytes_len s))
      (let! (a Int# (cirka$clamp i 0 n))
        (cirka$bytes_find_byte_loop s b a (cirka$clamp j a n))))))

(def cirka$bytes_range_eq_loop (-> Bytes Int# Bytes Int# Int# Int#)
  (lam ((s Bytes) (i Int#) (t Bytes) (j Int#) (n Int#))
    (case (prim lt 0 n) (c Int#) Int#
      (0 1)
       (_ (case (prim eq (prim bytes_get s i) (prim bytes_get t j)) (d Int#) Int#
            (0 0)
             (_ (cirka$bytes_range_eq_loop s (prim add i 1) t (prim add j 1) (prim sub n 1))))))))

; s[i..i+n] == t[j..j+n] (0 when a range is out of bounds).
(def cirka$bytes_range_eq (-> Bytes Int# Bytes Int# Int# Int#)
  (lam ((s Bytes) (i Int#) (t Bytes) (j Int#) (n Int#))
    (case (prim lt n 0) (c0 Int#) Int#
      (0 (case (prim lt i 0) (c1 Int#) Int#
           (0 (case (prim lt j 0) (c2 Int#) Int#
                (0 (case (prim lt (prim bytes_len s) (prim add i n)) (c3 Int#) Int#
                     (0 (case (prim lt (prim bytes_len t) (prim add j n)) (c4 Int#) Int#
                          (0 (cirka$bytes_range_eq_loop s i t j n))
                           (_ 0)))
                      (_ 0)))
                 (_ 0)))
            (_ 0)))
       (_ 0))))

(def cirka$bytes_find_loop (-> Bytes Int# Int# Bytes Int# Int# Int#)
  (lam ((s Bytes) (i Int#) (last Int#) (p Bytes) (first Int#) (m Int#))
    (case (prim lt last i) (c Int#) Int#
      (0 (let! (k Int# (cirka$bytes_find_byte_loop s first i (prim add last 1)))
           (case (prim lt k 0) (d Int#) Int#
             (0 (case (cirka$bytes_range_eq_loop s k p 0 m) (e Int#) Int#
                  (0 (cirka$bytes_find_loop s (prim add k 1) last p first m))
                   (_ k)))
              (_ -1))))
       (_ -1))))

; The first index in [i, j) (clamped) where p starts (p fits before j),
; or -1. The empty pattern is found at i.
(def cirka$bytes_find (-> Bytes Int# Int# Bytes Int#)
  (lam ((s Bytes) (i Int#) (j Int#) (p Bytes))
    (let! (n Int# (prim bytes_len s))
      (let! (a Int# (cirka$clamp i 0 n))
        (let! (b Int# (cirka$clamp j a n))
          (let! (m Int# (prim bytes_len p))
            (case m (c Int#) Int#
              (0 a)
               (_ (cirka$bytes_find_loop s a (prim sub b m) p (prim bytes_get p 0) m)))))))))

; Copies s[i..j] (clamped) to u at off (clamped to fit) and returns u.
(def cirka$bytes_write (-> Bytes Int# Bytes Int# Int# Bytes)
  (lam ((u Bytes) (off Int#) (s Bytes) (i Int#) (j Int#))
    (let! (n Int# (prim bytes_len s))
      (let! (a Int# (cirka$clamp i 0 n))
        (let! (b Int# (cirka$clamp j a n))
          (let! (o Int# (cirka$clamp off 0 (prim bytes_len u)))
            (let! (room Int# (prim sub (prim bytes_len u) o))
              (cirka$bytes_copy_at u o s a (cirka$clamp (prim sub b a) 0 room)))))))))
