# Copy this file to .env and adjust for your environment.
# .env is git-ignored. Both scripts/ and compose.yaml read it.

# ---- Toolchain ----------------------------------------------------------
# LLVM major version used by the backend (clang/llc/opt/lld).
CIRKA_LLVM_VERSION=18
# Commands used by achc to assemble and link generated LLVM IR.
CIRKA_CLANG=clang-18
CIRKA_OPT=opt-18
CIRKA_LLC=llc-18
# Compilation target triple (only x86_64 Linux is supported for now).
CIRKA_TARGET=x86_64-unknown-linux-gnu

# ---- Testing ------------------------------------------------------------
# GHC used as the reference implementation for differential testing.
# Leave empty to skip differential tests.
CIRKA_GHC=ghc
# Path to a checkout of GHC's testsuite (testsuite/tests) for compat runs.
CIRKA_GHC_TESTSUITE_DIR=
# Parallel jobs for the run-test harness (0 = number of CPUs).
CIRKA_TEST_JOBS=0
# Directory for temporary AI-generated artifacts (git-ignored).
CIRKA_ARTIFACTS_DIR=docs/artifacts

# ---- Verification (opt-in, see docs/design/13-verification.md) -----------
# SMT solver used by `achc verify`. Leave empty to skip verification tests.
CIRKA_Z3=z3
# Per-query solver timeout in milliseconds.
CIRKA_VERIFY_TIMEOUT=10000

# ---- Runtime defaults (read by compiled programs) -----------------------
# Main thread stack size. Haskell code can recurse deeply.
CIRKA_STACK_SIZE=512M
# 1 = report leaked objects at exit (debug runtime only).
CIRKA_LEAK_CHECK=0
# Allocator: "cirka" (size-class allocator) or "system" (malloc; use with valgrind/ASan).
CIRKA_ALLOC=cirka

# ---- Vulkan (CirkaLang v0.0.6, compute only inside Docker) --------------
# Optional path to a Vulkan ICD json. Empty = loader default (Mesa lavapipe in Docker).
CIRKA_VULKAN_ICD=

# ---- Remote GUI verification (optional, see docs/design/15-gpu-and-remote.md)
# Environment-specific: put real values ONLY in your .env (git-ignored).
# Never write real host names or paths in tracked files.
# *_HOST:    name usable as `ssh <value>` (e.g. an alias from ~/.ssh/config)
# *_WORKDIR: project work directory on the remote machine
# Leave empty to skip that remote target.
CIRKA_REMOTE_MAC_HOST=
CIRKA_REMOTE_MAC_WORKDIR=
CIRKA_REMOTE_WIN_HOST=
CIRKA_REMOTE_WIN_WORKDIR=

# ---- Docker -------------------------------------------------------------
CIRKA_DOCKER_IMAGE=achc-dev
# Match these to `id -u` / `id -g` so files created in the container are yours.
CIRKA_UID=1000
CIRKA_GID=1000

# ---- Logging ------------------------------------------------------------
# achc log level: error | warn | info | debug | trace
CIRKA_LOG=info
RUST_BACKTRACE=1
